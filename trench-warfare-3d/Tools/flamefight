#!/usr/bin/env bash
# A REAL flame fight, captured deterministically: one flamethrower man (archetype 36) against a held rifle section
# ten metres off his nose, photographed close (T2, 16 m) and at the standard view (O120, 120 m).
#   usage: Tools/flamefight <prefix> [night|day]
#
# THREE VIEWS, TWO LIGHTS (look-05). close (16 m, over his shoulder) answered "is the jet drawn at all" and nothing
# else: the master read look-03's close shot as "a glow round the man and firelight washed over the mud", and from a
# camera above and behind the stream there is no silhouette to judge. `side` is a low camera 14 m off the aim, level
# with his chest, which is the view a stream has a SHAPE in. `night` is the game; `day` is the gym's clear noon
# (Editor/Gym.cs, light=day), because fire flatters itself in rain at night and a jet has to read against bright mud
# too. Night shots keep their old names (<prefix>_close.png); day shots are <prefix>_day_close.png.
#
# Each shot writes <name>.json beside the png: the muzzle and the target as PIXELS in that picture (Camera.main's
# WorldToScreenPoint, y flipped to image rows). Tools/flameband.py --sidecar then measures the stream's shape without
# anyone eyeballing two coordinates off a screenshot - which is how look-03 was judged, and badly.
#
# Tools/flameshots pokes the effect by hand (fx.Burst) and so can never tell whether anything ROUTES a sim Shot to
# it. This rig never calls Burst: it stages the fight and photographs whatever the game draws, so an unwired build
# comes back with rifle tracers and no jet, and prints jets=0 beside the pictures to say so.
#
# Ten metres, not the gym's seventy: the weapon reaches eleven (Flamethrower.Reach), and at seventy he never fires.
# Four riflemen, not eight: at nine metres eight of them killed him in under half a second, before a single frame of
# the fight could be photographed. Four leave him about a second alive, which is three captures' worth.
#
# BATCH MODE. This machine has no desktop session, so nothing here may touch a window: entering Play through
# `tw run editor_play` makes Unity build the play-mode layout, the Game View asks d3d11 for a swap chain, that fails
# (0x887a0022) and the editor dies in a native crash - the whole first run of this rig was lost to it. So Play is
# entered by setting EditorApplication.isPlaying from eval, and the pictures are taken by TankCapture.Shot, which
# renders Camera.main into a RenderTexture (no Game View) - the way Tools/assetboard/gamefilm.py films the game.
# Start the editor first:  Unity.exe -batchmode -projectPath <checkout> -logFile <log>   (never -nographics: the
# pictures need the card).
#
# LOOK-09 added three things, all of them so that a question is settled by a PICTURE instead of by reading code:
#   * the final report prints every CombatFx tracer's from/to in PIXELS of the side picture, through the very same
#     viewport maths snap() writes the sidecars with. The master saw "thin straight pale-yellow lines running along
#     and past the stream" in both side views; a pair of pixel coordinates landing on a line names its shooter, and
#     reading CombatFx.OnSimEvent cannot. The list is private, so the rig reaches it by reflection: this is a
#     diagnostic rig and that keeps the change out of production code.
#   * a CONTROL SHOT, <prefix>_<tag>noflame, taken from the side camera one frame after Flamethrower.Active.Clear()
#     drops every jet, pool, torch and pyre. Anything still drawn in it is NOT the flame man's. flame2 argued the
#     pink streak away from the code and from TracerReport; this proves the same kind of claim by subtraction.
#   * the spawn and the camera's frame point are VARIABLES, and close is also snapped from three frame points
#     (close_x50, close_x60, close_x70). flame3's close shot showed only a short flare between the man and a tree
#     trunk, and the rig stands him where that trunk is; the three probes find a frame with the whole run in clear
#     view instead of guessing at one.
#
# Game time is stepped, never slept: a wall-clock wait lands on a different cel every run and the phase difference
# then reads as a regression (Tools/flameshots says why at length).
set -u
P="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"; T="$P/Tools/tw"; PRE="${1:-fight}"; LIGHT="${2:-night}"
case "$LIGHT" in night) TAG="" ;; day) TAG="day_" ;; *) echo "light must be night or day, not $LIGHT" >&2; exit 2 ;; esac
# A Windows path with FORWARD slashes: C# takes it, and a backslash here is eaten by the shell quoting
# (@"...\${PRE}..." lost its separator and the pictures went to Tools/flame-shots<prefix>_close.png,
# a file beside the folder, while the stale ones inside it still measured fine).
WP="$(cygpath -m "$P" 2>/dev/null || echo "$P")"
OUT="$P/Tools/flame-shots"; mkdir -p "$OUT"
# The staging and the framing, as numbers rather than buried literals (look-09). SPAWN is where the flame man is put
# and the riflemen are lined up ten metres off; FRAME is the point the game camera is framed on for close and std.
# They are OVERRIDES, not literals, because the default staging is not the only one worth photographing: at (60,60)
# the ground rises into the parapet six metres out and a splintered trunk stands across the stream, so the close
# shot is a short flare (FlameJetCard.Report prints len=6.0m against a Reach of 11). Staged at (45,40) the same
# fight reads len=11.0m and the close shot shows the whole run - but the SIDE camera there has a trunk of its own
# across the middle, which splits the stream and makes flameband call it a BLOB. So the measured shots keep (60,60)
# and the open-ground pair is taken on top:
#   FF_SPAWN_X=45 FF_SPAWN_Z=40 FF_FRAME_X=45 FF_FRAME_Z=45 Tools/flamefight open night
SPAWN_X=${FF_SPAWN_X:-60}; SPAWN_Z=${FF_SPAWN_Z:-60}; FRAME_X=${FF_FRAME_X:-60}; FRAME_Z=${FF_FRAME_Z:-65}
CLOSE_PROBES="50 60 70"   # extra close shots, one per frame-point x, to find ground clear of the trench-line trunks
val() { grep -o '"result": "[^"]*"' | sed 's/.*: "//;s/"$//'; }
step() { "$T" eval "UnityEditor.EditorApplication.isPaused=true; for(int i=0;i<${1};i++) UnityEditor.EditorApplication.Step(); return 0;" >/dev/null 2>&1; }

# Unity keeps the LAST GOOD assemblies when a compile fails, so Play still runs and the shots come out silently of
# the previous build. Refuse rather than photograph the wrong code.
if "$T" run console_status | grep -q '"compilationFailed": true'; then
  echo "COMPILE FAILED - not capturing. Fix it first:" >&2
  grep -a -o 'Assets[^)]*): error CS[0-9]*: [^"]*' "$LOCALAPPDATA/Unity/Editor/Editor.log" 2>/dev/null | tail -5 >&2
  exit 1
fi

# A recompile during Play nulls SimHost.Local and the session throws every frame afterwards, which reads as a code
# fault and is only a stale session. Every run after an edit starts Play again.
"$T" eval 'UnityEditor.EditorApplication.isPlaying=false; return 0;' 60 >/dev/null 2>&1
sleep 5
"$T" eval 'UnityEditor.SceneManagement.EditorSceneManager.OpenScene("Assets/_Project/Scenes/GreyboxCorridor.unity");
UnityEditor.EditorApplication.isPlaying=true; return "play";' 180 >/dev/null 2>&1

# The right scene, in Play, with the effect alive in it. A fresh editor opens an untitled one and the run still
# "succeeds", capturing a blue sky over flat grey ground - two shots of nothing, both of which measure cleanly.
SC=""
for i in $(seq 1 30); do
  SC=$("$T" eval 'return UnityEditor.EditorApplication.isPlaying+"/"+UnityEngine.SceneManagement.SceneManager.GetActiveScene().name+"/"+(TW.Presentation.Tactical.Flamethrower.Active!=null);' | val)
  case "$SC" in True/GreyboxCorridor/True) break ;; esac
  sleep 5
done
echo "  scene=$SC"
case "$SC" in
  True/GreyboxCorridor/True) ;;
  *) echo "NOT IN PLAY IN THE RIGHT SCENE ($SC) - not capturing" >&2; exit 1 ;;
esac

# light=day: the Gym's own recipe (Editor/Gym.cs). The scene FILE has no Atmosphere - GreyboxTerrainView adds one
# when Play starts - so it is found here, after Play, and not before.
if [ "$LIGHT" = day ]; then
  echo "  light: $("$T" eval 'var sky=UnityEngine.Object.FindFirstObjectByType<TW.Presentation.Terrain.Atmosphere>();
if(sky==null) return "NO ATMOSPHERE - still night";
sky.Relight(TW.Presentation.Terrain.BiomeProfile.ClearDay()); sky.Rain=0f; sky.Squalls=0f; return "clear day";' 90 | val)"
else
  echo "  light: night (the game's own)"
fi

# PAUSE FIRST, then stage. Each CLI call is a second or two of wall clock and the editor only actually stops inside
# one, so staging an unpaused fight lets it run itself out - and it is over in a second - in the gaps between calls.
"$T" pause true >/dev/null 2>&1

# Flamethrower.cs makes dozens of Random draws (tongue placement, card sizes, frame phases, handedness); seeding
# before the staging makes two runs of this script the same picture.
# ClearEnemies first: a previous staging's riflemen are still standing there and would shoot this one down.
"$T" eval 'TW.Editor.RiderLab.ClearEnemies(0, 999f); return 0;' 90 >/dev/null 2>&1
SLOT=$("$T" eval 'UnityEngine.Random.InitState(20250925);
var fx=TW.Presentation.Tactical.Flamethrower.Active; fx.Clear();
var m=TW.Editor.TankCapture.Spawn(0, 36, '"$SPAWN_X"'f, '"$SPAWN_Z"'f, 0f);
if(!m.StartsWith("slot ")) return "spawn failed: "+m;
int s=int.Parse(m.Substring(5).Split(new string[]{" "}, System.StringSplitOptions.None)[0]);
TW.Editor.RiderLab.Enemies(s, 4, 10f);
TW.Editor.RiderLab.Stop(s);
return s.ToString();' 90 | val)
case "$SLOT" in
  ''|*[!0-9]*) echo "STAGING FAILED ($SLOT)" >&2; exit 1 ;;
esac
echo "  flame man in slot $SLOT at ($SPAWN_X, $SPAWN_Z), 4 riflemen 10 m off his nose"

# Wait for the fight to actually START, do not count frames at it. On a freshly started editor the first
# frames after the staging go on settling (the sim had not fired a shot yet: man=100 hp, every enemy 100,
# jets=0) and the pair of captures then shows two men standing still - a picture that proves nothing either
# way. Step until somebody has lost a hit point, then photograph; he only lives about a second after that.
for i in $(seq 1 20); do
  step 4
  HIT=$("$T" eval 'var cf=UnityEngine.Object.FindFirstObjectByType<TW.Presentation.Tactical.CombatFx>(); var w=cf.Host.Local.World;
int s='"$SLOT"'; float worst=100f;
for(int i=s;i<=s+4 && i<w.HighWater;i++) worst=UnityEngine.Mathf.Min(worst, w.IsAlive(i)?w.Hp[i]:0f);
return (worst<99.5f)?"on":"off";' | val)
  [ "$HIT" = "on" ] && break
done
echo "  fight joined after $i rounds of 4 frames"

# Each shot: frame the band and queue the capture in one call, then step so the frame it renders in is drawn.
# The whole pair has to fit inside the second he is alive, so the camera is not eased - FrameFrom sets it outright.
# The muzzle and the target in WORLD space, for the sidecars and for the side camera to aim at: the same two points
# CombatFx uses when it opens the stream (his chest, and 0.6 m above the ground at the man he fired at).
aim_world() { "$T" eval 'var cf=UnityEngine.Object.FindFirstObjectByType<TW.Presentation.Tactical.CombatFx>(); var w=cf.Host.Local.World;
int s='"$SLOT"'; var man=(UnityEngine.Vector3)w.Position[s]; man.y=TW.Presentation.RenderGround.Sample(cf.Host.Local.Map, man.x, man.z);
int best=-1; float bd=1e9f;
for(int i=s+1;i<s+9 && i<w.HighWater;i++){ if(!w.IsAlive(i)) continue; var q=(UnityEngine.Vector3)w.Position[i]; float d=(q-man).sqrMagnitude; if(d<bd){bd=d;best=i;} }
if(best<0) return "no enemy alive";
var at=(UnityEngine.Vector3)w.Position[best]; at.y=TW.Presentation.RenderGround.Sample(cf.Host.Local.Map, at.x, at.z)+0.6f;
var mouth=man+UnityEngine.Vector3.up*1.1f;
var iv=System.Globalization.CultureInfo.InvariantCulture;
return mouth.x.ToString("F3",iv)+","+mouth.y.ToString("F3",iv)+","+mouth.z.ToString("F3",iv)+","+at.x.ToString("F3",iv)+","+at.y.ToString("F3",iv)+","+at.z.ToString("F3",iv);' 90 | val; }

# Queue the capture AND write the sidecar in the same call, so the pixels are read off the very camera that renders.
# VIEWPORT coordinates, not screen ones: in batch mode Camera.main.pixelWidth is the editor's game view, which is not
# the 1600x900 the capture renders into, and the first run of this put the muzzle at x=2094 of a 1600-wide picture.
# The aspect is forced to the capture's for the same reason (TankCapture's RenderTexture sets it when it renders, not
# now) and handed straight back. Viewport y counts up from the bottom; an image row counts down from the top.
snap() {   # snap <name>
  "$T" eval "var cam=UnityEngine.Camera.main; int W=1600,H=900; var iv=System.Globalization.CultureInfo.InvariantCulture;
var mouth=new UnityEngine.Vector3(${AIM0}f,${AIM1}f,${AIM2}f); var at=new UnityEngine.Vector3(${AIM3}f,${AIM4}f,${AIM5}f);
cam.aspect=W/(float)H;
var a=cam.WorldToViewportPoint(mouth); var b=cam.WorldToViewportPoint(at);
cam.ResetAspect();   // wasAspect is only read to prove nothing else had overridden it
System.IO.File.WriteAllText(@\"${WP}/Tools/flame-shots/${PRE}_${TAG}$1.json\",
  \"{\\\"muzzle\\\":[\"+(a.x*W).ToString(\"F1\",iv)+\",\"+((1f-a.y)*H).ToString(\"F1\",iv)+\"],\\\"target\\\":[\"+(b.x*W).ToString(\"F1\",iv)+\",\"+((1f-b.y)*H).ToString(\"F1\",iv)+\"]}\");
TW.Editor.TankCapture.Shot(@\"${WP}/Tools/flame-shots/${PRE}_${TAG}$1.png\", W, H); return 0;" >/dev/null 2>&1
  step 3
  echo "  $OUT/${PRE}_${TAG}$1.png"
}

# The TacticalCamera drives Camera.main every LateUpdate, so a hand-placed camera has to be taken off it first and
# given back afterwards - never left off, or every later shot in this run frames whatever the side view framed.
tcon() { "$T" eval 'var tc=UnityEngine.Camera.main.GetComponent<TW.Presentation.Tactical.TacticalCamera>(); tc.enabled=true; return 0;' >/dev/null 2>&1; }

shoot() {   # shoot <name> <zoom> [frame x]   - the game's own camera, framed on the fight
  tcon
  "$T" eval "var cam=UnityEngine.Camera.main; var tc=cam.GetComponent<TW.Presentation.Tactical.TacticalCamera>();
tc.FrameFrom(new UnityEngine.Vector2(${3:-$FRAME_X}f, ${FRAME_Z}f), ${2}f, 0f); return 0;" >/dev/null 2>&1
  step 1    # TacticalCamera writes the transform in LateUpdate: without a frame here the shot is framed where the
            # PREVIOUS one was (side and std came back with byte-identical sidecars the first time)
  snap "$1"
}

pose_side() {   # a LOW camera, level with his chest, 14 m off the side of the aim: the view a stream has a shape in
  "$T" eval "var cam=UnityEngine.Camera.main; cam.GetComponent<TW.Presentation.Tactical.TacticalCamera>().enabled=false;
var mouth=new UnityEngine.Vector3(${AIM0}f,${AIM1}f,${AIM2}f); var at=new UnityEngine.Vector3(${AIM3}f,${AIM4}f,${AIM5}f);
var mid=(mouth+at)*0.5f; var fwd=at-mouth; fwd.y=0f;
if(fwd.sqrMagnitude<0.01f) fwd=UnityEngine.Vector3.forward; fwd=fwd.normalized;
var side=UnityEngine.Vector3.Cross(UnityEngine.Vector3.up, fwd);
var eye=mid+side*14f+UnityEngine.Vector3.up*4f;
cam.transform.position=eye; cam.transform.rotation=UnityEngine.Quaternion.LookRotation((mid-eye).normalized, UnityEngine.Vector3.up);
return 0;" >/dev/null 2>&1
}

# EVERY LIVE TRACER IN PIXELS OF THE SIDE PICTURE (look-09, question 2). The same viewport maths snap() writes the
# sidecars with - viewport coordinates scaled to 1600x900, y flipped to image rows - so a pale line the master can
# point at on after_side.jpg is matched to a shooter by its coordinates, which reading CombatFx.OnSimEvent cannot do.
# CALLED FROM shoot_side, NOT FROM THE FINAL REPORT, and that is a correction the first run of this forced: a tracer
# lives CombatFx.TracerSeconds = 0.12 s, the run steps a dozen frames between the side shot and the report, and the
# report duly printed "tracers=0 ... live=0 of 0" for a picture that may well have had lines in it. A pixel is only
# a pixel of one view and only of one frame, so this is read in the same pose, in the same frame, as the snap.
# tracers is private to CombatFx: read by reflection, because a diagnostic rig should not grow production an accessor.
tracer_pixels() {
  echo "    tracers in side pixels: $("$T" eval 'var cf=UnityEngine.Object.FindFirstObjectByType<TW.Presentation.Tactical.CombatFx>();
var cam=UnityEngine.Camera.main; int W=1600,H=900; cam.aspect=W/(float)H;
var iv=System.Globalization.CultureInfo.InvariantCulture;
var fi=typeof(TW.Presentation.Tactical.CombatFx).GetField("tracers", System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.Instance);
var list=(System.Collections.IList)fi.GetValue(cf);
var ty=fi.FieldType.GetGenericArguments()[0];
var fF=ty.GetField("From"); var fT=ty.GetField("To"); var fB=ty.GetField("Born"); var fTm=ty.GetField("Team");
var sb=new System.Text.StringBuilder(); float now=UnityEngine.Time.time; int live=0;
System.Func<UnityEngine.Vector3,string> px = v => { var q=cam.WorldToViewportPoint(v);
  return "("+(q.x*W).ToString("F0",iv)+","+((1f-q.y)*H).ToString("F0",iv)+")"; };
for(int i=0;i<list.Count;i++){ var t=list[i]; float born=(float)fB.GetValue(t);
  if(now<born || born<now-cf.TracerSeconds) continue; live++;
  sb.Append(" [team="+(byte)fTm.GetValue(t)+" "+px((UnityEngine.Vector3)fF.GetValue(t))+"->"+px((UnityEngine.Vector3)fT.GetValue(t))+"]"); }
cam.ResetAspect();
return "live="+live+" of "+list.Count+sb;' 90 | val)"
}

shoot_side() {
  pose_side
  snap side
  tracer_pixels   # in the side pose, within a frame of the snap: a tracer only lives 0.12 s
  tcon
}

# THE CONTROL SHOT. Clear() drops the jets, the burning pools, the men alight and the pyres - everything Flamethrower
# draws - and nothing else in the frame. One frame later, from the same side pose, whatever is still drawn is not his.
# The sim keeps burning men, so the effect refills on later frames and the std shot after this is a normal one.
shoot_noflame() {
  pose_side
  "$T" eval 'TW.Presentation.Tactical.Flamethrower.Active.Clear(); return 0;' >/dev/null 2>&1
  step 1
  snap noflame
  tcon
}

# T2 (close) and O120 (the standard view) are the gym's own band zooms, Perf/GymCatalogue.cs.
AIM=$(aim_world)
case "$AIM" in
  *,*,*,*,*,*) ;;
  *) echo "NO AIM ($AIM) - not capturing" >&2; exit 1 ;;
esac
IFS=, read -r AIM0 AIM1 AIM2 AIM3 AIM4 AIM5 <<< "$AIM"
echo "  muzzle ($AIM0, $AIM1, $AIM2) -> target ($AIM3, $AIM4, $AIM5)"

shoot close 16
for FX in $CLOSE_PROBES; do shoot "close_x$FX" 16 "$FX"; done
shoot_side
shoot std 120

# What the sim and the effect each think is happening. jets=0 while his target is losing hit points IS the bug this
# rig exists for: the sim is burning men and nothing is drawing the jet.
echo "  $("$T" eval 'var cf=UnityEngine.Object.FindFirstObjectByType<TW.Presentation.Tactical.CombatFx>(); var w=cf.Host.Local.World;
var fx=TW.Presentation.Tactical.Flamethrower.Active; var sb=new System.Text.StringBuilder();
sb.Append(cf.TracerReport()+" ");
sb.Append(TW.Presentation.Tactical.FlameJetCard.Report()+" ");
sb.Append("jets="+fx.Jets+" fires="+fx.Fires+" man="+(w.IsAlive('"$SLOT"')?w.Hp['"$SLOT"'].ToString("F0")+" hp":"dead"));
for(int i='"$SLOT"'+1;i<='"$SLOT"'+4;i++) sb.Append(i==w.HighWater?"":" e"+i+"="+(w.IsAlive(i)?w.Hp[i].ToString("F0"):"dead"));
return sb.ToString();' | val)"

# The control shot comes AFTER the report, not before it: Clear() empties the effect's books, and the first run
# of this printed "cards=0 quads=0 jets=0 fires=0" beside a side picture that plainly had a jet in it.
shoot_noflame

# A capture with no fire in it is worse than no capture: it measures cleanly and the numbers mean nothing.
# flamecheck asks "is there fire at all"; flameband asks "is it a BAND from the muzzle to the target, or a blob round
# the man". look-03 passed the first with 143028 lit pixels and fails the second, and that gap is the whole of
# look-05. Only close and side are measured - at 120 m a correct jet is a few hundred pixels and would fail the
# floor honestly.
for V in close side; do
  echo "  $V:"
  python "$P/Tools/flamecheck.py" "$OUT/${PRE}_${TAG}${V}.png" 2>&1 | sed 's/^/    /'
  python "$P/Tools/flameband.py" "$OUT/${PRE}_${TAG}${V}.png" --sidecar "$OUT/${PRE}_${TAG}${V}.json" 2>&1 | sed 's/^/    /'
done
