/* Battle HUD layout: where each region sits and how it is laid out inside. Nothing about colour or texture lives
   here (dustfront.uss), and the UXML carries no positions. The owner's decision keeps today's positions (silver
   top-left, bar along the bottom, minimap top-right, orders on the trenches); the faithful Dust Front arrangement
   (left card column, gauge cluster beside the radar, objectives top-left) is a second copy of this sheet. */

.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-region { position: absolute; }
.hud-region--topleft { left: 12px; top: 12px; flex-direction: column; align-items: flex-start; }
.hud-region--topright { right: 14px; top: 12px; flex-direction: column; align-items: flex-end; }
.hud-region--bottom { left: 0; right: 0; bottom: 0; height: var(--tw-bar-height); flex-direction: row; justify-content: center; align-items: flex-end; }

/* gauges and objectives, top-left */
.hud-gauges { width: 220px; padding: 8px 12px 4px 12px; flex-direction: column; }   /* round 7: 256 left a quarter of the column empty */
.hud-objectives { width: 220px; margin-top: 8px; padding: 8px 12px 8px 12px; }
.hud-objectives__title { margin-bottom: 6px; color: var(--tw-text); -unity-font-style: bold; }
.hud-objectives__list { flex-direction: column; }
.hud-objective { flex-direction: row; align-items: center; min-height: 22px; }
.hud-objective__name { font-size: var(--tw-size-caption); flex-grow: 1; }
.hud-objective__progress { font-size: var(--tw-size-caption); color: var(--tw-accent); margin-left: 8px; min-width: 40px; -unity-text-align: middle-right; }
.hud-objectives.is-empty { display: none; }

/* minimap and speed, top-right */
.hud-bezel { padding: var(--tw-minimap-bezel); background-color: var(--tw-plate-700); border-radius: var(--tw-radius-lg); }
.hud-bezel--square { background-image: url("../../Skin/Sprites/plate_normal.png"); -unity-slice-left: 16; -unity-slice-top: 16; -unity-slice-right: 16; -unity-slice-bottom: 16; -unity-slice-scale: 1px; background-color: var(--tw-plate-700); border-radius: var(--tw-radius-lg); }   /* round 11: the same riveted plate as the gauges */
.hud-bezel--round { background-image: url("../../Skin/Sprites/bezel_round.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0; border-radius: 50%; overflow: hidden; }
.hud-minimap { background-color: var(--tw-plate-900); width: 100px; height: 60px; border-radius: var(--tw-radius-sm); overflow: hidden; }   /* size set in code from the map */
.hud-minimap__layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.hud-minimap__view { position: absolute; border-width: 2px; border-color: var(--tw-accent-bright); width: 8px; height: 6px; }   /* round 11: amber, 2 px, so "where am I looking" survives next to a bone trench line */
.hud-speed { margin-top: 8px; padding: 6px 10px 6px 6px; flex-direction: row; }   /* the first button carries a 4 px margin: 10 px end fields both sides */
.hud-speed__btn { width: 40px; height: 40px; min-height: 0; padding: 0; margin-left: 4px; font-size: var(--tw-size-caption); background-image: url("../../Skin/Sprites/row_plate.png"); -unity-slice-left: 12; -unity-slice-top: 8; -unity-slice-right: 12; -unity-slice-bottom: 8; border-radius: var(--tw-radius); }
.hud-speed__btn.tw-btn--on { background-color: #2C2E33; border-bottom-width: 2px; border-bottom-color: var(--tw-accent); color: var(--tw-accent-bright); }
.hud-speed__btn > .tw-icon { width: 18px; height: 18px; align-self: center; }

/* the bar, bottom centre */
.hud-bar { flex-shrink: 0; background-image: url("../../Skin/Sprites/plate_normal.png"); -unity-slice-left: 16; -unity-slice-top: 16; -unity-slice-right: 16; -unity-slice-bottom: 16; flex-direction: row; align-items: flex-end; padding: 6px var(--tw-bar-inset) 8px var(--tw-bar-inset); height: var(--tw-bar-height); margin-bottom: 12px;   /* HudLayout.BarBottomMarginPx (round 11) */ }
/* the infantry stand as tall as the ARMOUR row over the SUPPORT row (HudLayout.StackHeightPx); caption top, cards bottom */
.hud-group--infantry { }
.hud-group-stack { flex-direction: column; justify-content: space-between; height: 196px; margin-left: var(--tw-card-gap); }   /* HudLayout.StackHeightPx */
/* SUPPORT is captioned above its row like ARMOUR (round 8: beside it saved nothing at 1x and broke the rule) */
.hud-cards--infantry .tw-card { width: var(--tw-card-size-infantry); height: var(--tw-card-size-infantry); }
.hud-cards--infantry .tw-card__portrait { left: 8px; top: 8px; right: 8px; bottom: 8px; }
.hud-cards--infantry .tw-card__nameplate { height: 22px; left: 12px; right: 12px; bottom: 4px; padding-left: 24px; padding-right: 24px; font-size: 13px; }
.hud-cards--infantry .tw-card__cost { height: 22px; right: 18px; top: 18px; padding: 0 6px; font-size: 15px; }
.hud-cards--infantry .tw-card__hotkey { height: 22px; min-width: 22px; left: 18px; top: 18px; font-size: 12px; }   /* inside the art window (round 10) */
.hud-cards--infantry .tw-card__weapon { width: 18px; height: 18px; left: 10px; bottom: 6px; }   /* in the footer, off the art (the footer draws first now) */
.hud-cards--infantry .tw-card__badge { height: 20px; min-width: 22px; right: 4px; bottom: 28px; font-size: 12px; }
.hud-cards--infantry .tw-card__lock { left: 40px; top: 40px; right: 40px; bottom: 40px; }
.hud-group { flex-direction: column; align-items: flex-start; }
.hud-group__caption { height: 14px; margin: 0 0 2px 10px; font-size: var(--tw-size-micro); color: var(--tw-text); -unity-font-style: bold; }
.hud-cards { flex-direction: row; }
/* a gap before every card but each group's first (USS has no :first-child/:last-child; HudView marks the first) */
.hud-cards > .hud-card-slot { flex-shrink: 0; margin-left: var(--tw-card-gap); }
.hud-cards > .hud-card-slot.hud-card-slot--first { margin-left: 0; }
/* a card gap then the divider, as BattleHud laid out its cells: HudLayout.BarWidth counts both */
.hud-bar__divider { width: var(--tw-bar-divider); margin: 0 0 0 var(--tw-card-gap); height: 180px; background-color: rgba(0, 0, 0, 0); background-image: none; align-items: center; justify-content: center; }
.hud-card { }
.hud-tooltip { position: absolute; bottom: 232px; left: 50%; translate: -50% 0; display: none; }
.hud-tooltip.is-visible { display: flex; }
.hud-hint { position: absolute; bottom: 230px; left: 0; right: 0; -unity-text-align: middle-center; color: var(--tw-text-bright); display: none; }
.hud-hint.is-visible { display: flex; }

/* trench order clusters */
.hud-orders-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-orders { position: absolute; left: 0; top: 0; flex-direction: column; align-items: center; width: 340px; }
.hud-orders__row { flex-direction: row; align-items: center; }
.hud-orders__pair { flex-direction: row; padding: 4px; background-color: rgba(14, 15, 16, 0.86); border-width: 1px; border-color: #3A3D42; border-radius: var(--tw-radius-lg); }
.hud-orders__btn { margin-right: var(--tw-order-gap); }
.hud-orders__btn.hud-orders__btn--last { margin-right: 0; }   /* USS has no :last-child */
.hud-orders__btn > .tw-icon { width: 40px; height: 40px; }
.hud-orders__gap { width: 56px; height: var(--tw-order-btn); }   /* the pairs' 2 x (4 px padding + 1 px border) come out of the gap: the cluster stays 340 px */
.hud-orders__count { margin-top: 0; padding: 1px 8px; font-size: 13px; color: var(--tw-accent); background-color: var(--tw-plate-900); background-image: url("../../Skin/Sprites/gauge_window.png"); -unity-slice-left: 6; -unity-slice-top: 6; -unity-slice-right: 6; -unity-slice-bottom: 6; border-radius: var(--tw-radius-sm); -unity-font-definition: url("../../Skin/Fonts/DustFrontMono.asset"); }   /* round 11: a recessed window butted to the plates, not a loose pill */
.hud-orders.is-empty { opacity: 0.55; }
.hud-orders.is-empty:hover { opacity: 1; }
.hud-orders.is-empty .tw-icon { -unity-background-image-tint-color: var(--tw-text-dim); }
.hud-orders.is-hidden { display: none; }
/* an order that cannot be given dims as a whole button, never as a grey glyph on a normal plate (round 6) */
/* round 9: at 40% the plate went see-through and read as a hole; the plate stays opaque, the glyph dims */
.hud-orders__btn:disabled { opacity: 1; -unity-background-image-tint-color: #8A8A8A; }   /* round 10: the rivets no longer outshine the dimmed glyph */
.hud-orders__btn:disabled > .tw-icon { -unity-background-image-tint-color: #6B6C69; }
.hud-orders__btn--holdfire.tw-btn--on > .tw-icon { -unity-background-image-tint-color: var(--tw-alarm); }
.hud-gauges__vs { margin-left: 6px; margin-top: 6px; font-size: var(--tw-size-micro); color: var(--tw-text-dim); }
/* the enemy count is large enough to pass at 3:1 in rust (round 6) */
#silver-value { color: var(--tw-accent-bright); }
.tw-card__cost { color: var(--tw-accent); }
/* this sheet sits nearer the cards than the skin, so the states it overrides must be restated here: the round 7 amber
   silently won over "can't afford = red" (round 11, R0.8 regression) */
.tw-card.is-poor > .tw-card__cost { color: var(--tw-alarm); }
.tw-card.is-cooling > .tw-card__cost { color: var(--tw-text-dim); }
.tw-card.is-poor > .tw-card__portrait { -unity-background-image-tint-color: #5A5A5A; }
#silver-value { font-size: 26px; min-width: 120px; }   /* round 11: the treasury is the top number on screen */
#enemy-value { margin-top: 2px; font-size: 16px; -unity-font-style: bold; min-width: 40px; }

/* banner and pause plate, centre */
.hud-banner { position: absolute; left: 0; right: 0; top: 12%; align-items: center; display: none; }
.hud-banner.is-visible { display: flex; }
.hud-pause-plate { position: absolute; left: 50%; translate: -50% 0; top: 12px; padding: 6px 28px; display: none; }
.hud-pause-plate.is-visible { display: flex; }

/* the speaker strip, bottom-left above the roster bar (HudDialogue): portrait window, name, line */
/* the speaker strip sits in the bottom band beside the roster, its bottom on the card bottoms (round 5); where the
   roster is too wide to leave room (narrow screens) HudDialogue raises it above the bar with --raised. The name is
   bone for every speaker; a hurt report says so in a red status chip, and a critical one keylines the portrait. */
.hud-dialogue { position: absolute; left: 12px; bottom: 8px; width: 344px; min-height: 88px; flex-direction: row; align-items: center; padding: 12px 14px 12px 12px; }   /* 12 px clears the plate rivets */
.hud-dialogue--raised { left: auto; right: 14px; bottom: 234px; }   /* no room beside the bar: over its right end, clear of the objectives (round 7); BarHeightPx + 12 */
.hud-dialogue__frame { width: 80px; height: 80px; flex-shrink: 0; margin-right: 10px; overflow: hidden; border-width: 0; }
.hud-dialogue__portrait { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; background-position-y: bottom; }   /* the art stands on the window floor */
.hud-dialogue__body { flex-grow: 1; flex-shrink: 1; justify-content: center; }
.hud-dialogue__head { flex-direction: row; align-items: center; margin-bottom: 2px; }
.hud-dialogue__name { color: var(--tw-text); font-size: var(--tw-size-caption); -unity-font-style: bold; }
.hud-dialogue__status { display: none; margin-left: 8px; font-size: 10px; color: var(--tw-text); background-color: rgba(224, 43, 43, 0.2); border-width: 1px; border-color: var(--tw-alarm); border-radius: var(--tw-radius-sm); padding: 0 4px; }
.hud-dialogue__text { white-space: normal; color: var(--tw-text); font-size: 14px; margin: 0; padding: 0; -unity-paragraph-spacing: 0; }
.hud-dialogue.is-hurt .hud-dialogue__status { display: flex; }

.hud-dialogue.is-critical .hud-dialogue__frame { border-width: 2px; border-color: var(--tw-alarm); }   /* the art fills the window unless critical */
/* the minimap well: recessed like every other window (round 10), drawn over the map, never picked */
.hud-minimap__rim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-top-width: 2px; border-left-width: 2px; border-bottom-width: 1px; border-right-width: 1px; border-top-color: #0C0D0E; border-left-color: #0C0D0E; border-bottom-color: #3A3C3F; border-right-color: #3A3C3F; border-radius: var(--tw-radius-sm); }

/* ---- selection (owner, 2026-09-23: "as sleek and great as Dust Front") ------------------------------------------
   The drag box: a thin crimson line with the faintest wash, as Dust Front draws it (#A8142C sampled from its GIFs).
   The hover name: small grey caps beside the cursor. The panel sits under the speed bar, right-aligned with it. */
.hud-marquee { position: absolute; border-width: 1px; border-color: #A8142C; background-color: rgba(168, 20, 44, 0.07); }
/* marks on the field (SelectionMarkers): each .hud-mark sits on a unit's feet (transform), the hexagon centred on
   them and scaled to the footprint, the bar lifted over the head. Sizes here are the unscaled boxes the code scales. */
.hud-markers-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.hud-mark { position: absolute; left: 0; top: 0; width: 0; height: 0; }
.hud-mark__hex { position: absolute; left: -32px; top: -32px; width: 64px; height: 64px; -unity-background-scale-mode: stretch-to-fill; }
.hud-mark__bar { position: absolute; left: 0; top: 0; width: 30px; height: 6px; background-color: rgba(10, 11, 12, 0.9); border-width: 1px; border-color: #050506; border-radius: 2px; overflow: hidden; }
.hud-mark__fill { height: 100%; width: 100%; background-color: #D9485A; border-radius: 1px; }
.hud-mark__fill--enemy { background-color: #E02B2B; }
/* the hover card: a small dark plate beside the cursor, face left, name / state / health right */
.hud-hover { position: absolute; flex-direction: row; align-items: center; padding: 6px 10px 6px 6px; min-width: 200px; max-width: 300px; display: none; opacity: 0; translate: -6px 0; transition-property: opacity, translate; transition-duration: 0.08s, 0.08s; transition-timing-function: ease-out-cubic, ease-out-cubic; background-color: rgba(14, 15, 16, 0.92); border-width: 1px; border-color: rgba(232, 225, 210, 0.22); }
.hud-hover--shown { opacity: 1; translate: 0 0; }
.hud-hover--enemy { border-color: rgba(181, 82, 58, 0.7); }
.hud-hover__frame { width: 56px; height: 56px; flex-shrink: 0; margin-right: 10px; overflow: hidden; background-color: #0A0B0C; border-radius: var(--tw-radius-sm); }
.hud-hover__portrait { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; background-position-y: bottom; }
.hud-hover__count { position: absolute; right: 2px; bottom: 0; font-size: var(--tw-size-label); color: var(--tw-accent-bright); -unity-font-style: bold; -unity-font-definition: url("../../Skin/Fonts/DustFrontMono.asset"); -unity-text-outline-width: 1px; -unity-text-outline-color: #0A0B0C; }
.hud-hover__info { flex-grow: 1; flex-shrink: 1; }
.hud-hover__name { font-size: var(--tw-size-caption); color: var(--tw-text-bright); -unity-font-style: bold; letter-spacing: 1px; }
.hud-hover--enemy .hud-hover__name { color: var(--tw-enemy); }
.hud-hover__state { font-size: var(--tw-size-micro); color: var(--tw-text-dim); letter-spacing: 1px; margin-bottom: 4px; }
.hud-hover__state--warn { color: var(--tw-accent-bright); }
.hud-hover__state--alarm { color: #E02B2B; }
.hud-hover__hp-track { height: 5px; background-color: #0E0F10; border-width: 1px; border-color: #2A2C30; border-radius: 3px; overflow: hidden; margin-bottom: 2px; }
.hud-hover__hp-fill { height: 100%; width: 100%; background-color: #D9485A; }
.hud-hover--enemy .hud-hover__hp-fill { background-color: #E02B2B; }
.hud-hover__hp { font-size: var(--tw-size-micro); color: var(--tw-text); -unity-font-definition: url("../../Skin/Fonts/DustFrontMono.asset"); }
/* while aiming a strike: two lines beside the reticle; ours in reach turns alarm red */
.hud-aim { position: absolute; display: none; padding: 3px 8px; background-color: rgba(14, 15, 16, 0.85); border-left-width: 2px; border-color: var(--tw-enemy); }
.hud-aim__enemy { font-size: var(--tw-size-caption); color: var(--tw-text-bright); -unity-font-style: bold; letter-spacing: 1px; }
.hud-aim__enemy--none { color: var(--tw-text-dim); }
.hud-aim__ours { font-size: var(--tw-size-micro); color: var(--tw-text-dim); letter-spacing: 1px; }
.hud-aim__ours--danger { color: #E02B2B; -unity-font-style: bold; font-size: var(--tw-size-caption); }
/* a trench's men badge: amber when a third are shaken or pinned, red when half are pinned (they refuse over the top) */
/* the trench's troop categories (owner, 2026-09-24: they replace the hold-fire button): one chip per infantry type,
   the face filling a recessed window, the count bottom-right; a red pip when some are pinned; a bright rim when that
   category of this trench is selected. The over-the-top button wears an amber rim while it would send only them. */
.hud-orders__cats { flex-direction: row; align-items: center; }
.hud-orders__row { align-self: flex-start; }   /* the chips grow the right pair: anchor the row on its left so the gap stays over the trench */
.hud-selection__orders { margin-top: 8px; padding-top: 6px; border-top-width: 1px; border-color: #2A2C30; font-size: var(--tw-size-micro); color: var(--tw-accent-bright); letter-spacing: 1px; -unity-font-style: bold; white-space: normal; }
.hud-selection__orders--warn { color: #E02B2B; }
/* a skull where a man dies (DeathMarks): centred on him by transform, the count beside it when deaths merge */
.hud-skull { position: absolute; left: 0; top: 0; width: 0; height: 0; }
.hud-skull__icon { position: absolute; left: -15px; top: -15px; width: 30px; height: 30px; -unity-background-scale-mode: stretch-to-fill; }
.hud-skull__count { position: absolute; left: 14px; top: -12px; font-size: var(--tw-size-caption); color: var(--tw-text-bright); -unity-font-style: bold; -unity-font-definition: url("../../Skin/Fonts/DustFrontMono.asset"); -unity-text-outline-width: 1px; -unity-text-outline-color: #0A0B0C; }
.hud-skull--ours .hud-skull__count { color: #E02B2B; }
.hud-cat-chip { width: 44px; height: var(--tw-order-btn); margin-right: var(--tw-order-gap); overflow: hidden; background-color: #0A0B0C; border-width: 1px; border-color: #3A3D42; border-radius: var(--tw-radius-sm); }
.hud-cat-chip:hover { border-color: var(--tw-text-dim); }
.hud-cat-chip__face { position: absolute; left: 0; top: 2px; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; background-position-y: top; }
.hud-cat-chip__count { position: absolute; right: 2px; bottom: 0; font-size: var(--tw-size-caption); color: var(--tw-text-bright); -unity-font-style: bold; -unity-font-definition: url("../../Skin/Fonts/DustFrontMono.asset"); -unity-text-outline-width: 1px; -unity-text-outline-color: #0A0B0C; }
.hud-cat-chip__pip { position: absolute; left: 3px; top: 3px; width: 7px; height: 7px; border-radius: 4px; background-color: #E02B2B; display: none; }
.hud-cat-chip--pinned .hud-cat-chip__pip { display: flex; }
.hud-cat-chip--pinned .hud-cat-chip__count { color: #E02B2B; }
.hud-cat-chip--selected { border-width: 2px; border-color: var(--tw-text-bright); }
.hud-orders__btn--partial { border-width: 2px; border-color: var(--tw-accent-bright); }
.hud-orders__count-row { flex-direction: row; align-items: center; }
/* hold fire, beside the men badge: dim while firing at will, alarm red while holding; click (or F) switches it */
.hud-orders__holdtag { width: 22px; height: 22px; margin-left: 4px; -unity-background-image-tint-color: var(--tw-text-mute); }
.hud-orders__holdtag:hover { -unity-background-image-tint-color: var(--tw-text); }
.hud-orders__holdtag--on { -unity-background-image-tint-color: var(--tw-alarm); }
.hud-orders__count--shaken { color: var(--tw-accent-bright); border-width: 1px; border-color: var(--tw-accent-bright); }   /* the plain badge is amber too: the rim says it */
.hud-orders__count--pinned { color: #E02B2B; border-width: 1px; border-color: #E02B2B; background-color: #2A0E0B; }
.hud-hover__hint { font-size: var(--tw-size-micro); color: var(--tw-text-mute); margin-top: 3px; letter-spacing: 1px; }
.hud-selection { margin-top: 8px; width: 300px; padding: 10px 12px 12px 12px; display: none; }
.hud-selection__header { color: var(--tw-text); -unity-font-style: bold; margin-bottom: 6px; }
.hud-selection__single { flex-direction: row; align-items: flex-start; }
.hud-selection__frame { width: 96px; height: 96px; flex-shrink: 0; margin-right: 12px; overflow: hidden; }
.hud-selection__portrait { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; background-position-y: bottom; }
.hud-selection__info { flex-grow: 1; flex-shrink: 1; }
.hud-selection__name { font-size: var(--tw-size-label); color: var(--tw-text-bright); -unity-font-style: bold; }
.hud-selection__side { color: var(--tw-text-dim); margin-bottom: 8px; }
.hud-selection__side--enemy { color: var(--tw-enemy); }
.hud-selection__hp-track { height: 6px; background-color: #0E0F10; border-radius: 3px; overflow: hidden; margin-bottom: 4px; }
.hud-selection__hp-fill { height: 100%; width: 100%; background-color: #D9485A; }
.hud-selection__hp { font-size: var(--tw-size-caption); color: var(--tw-text); margin-bottom: 4px; }
.hud-selection__stats { color: var(--tw-text-dim); }
.hud-selection__grid { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; }
.hud-selection__tile { width: 88px; height: 88px; margin: 0 4px 4px 0; overflow: hidden; }
.hud-selection__tile:hover { border-width: 1px; border-color: var(--tw-text-dim); }
.hud-selection__tile-art { position: absolute; left: 2px; top: 2px; right: 2px; bottom: 8px; -unity-background-scale-mode: scale-to-fit; background-position-y: bottom; }
.hud-selection__tile-count { position: absolute; right: 4px; top: 2px; font-size: var(--tw-size-caption); color: var(--tw-accent-bright); -unity-font-style: bold; -unity-font-definition: url("../../Skin/Fonts/DustFrontMono.asset"); }
.hud-selection__tile-hp { position: absolute; left: 3px; right: 3px; bottom: 3px; height: 4px; background-color: #0E0F10; border-radius: 2px; overflow: hidden; }
.hud-selection__tile-hp-fill { height: 100%; width: 100%; background-color: #D9485A; }
.hud-groups { position: absolute; left: 12px; bottom: 12px; width: 212px; flex-direction: row; flex-wrap: wrap-reverse; }
.hud-group-chip { width: 38px; height: 30px; margin: 0 4px 4px 0; padding: 0 4px; flex-direction: row; align-items: center; justify-content: space-between; border-radius: var(--tw-radius); }
.hud-group-chip__digit { font-size: var(--tw-size-label); color: var(--tw-alarm); -unity-font-style: bold; -unity-font-definition: url("../../Skin/Fonts/DustFrontMono.asset"); }
.hud-group-chip__size { font-size: var(--tw-size-micro); color: var(--tw-text-dim); -unity-font-definition: url("../../Skin/Fonts/DustFrontMono.asset"); }
/* a group in trouble (GroupAlerts): a pip top-right and the rim; HIT flashes (code toggles --flash), LOST greys out */
.hud-group-chip__pip { position: absolute; right: 3px; top: 3px; width: 6px; height: 6px; border-radius: 3px; display: none; }
.hud-group-chip--pinned { border-width: 1px; border-color: var(--tw-accent-bright); }
.hud-group-chip--pinned .hud-group-chip__pip { display: flex; background-color: var(--tw-accent-bright); }
.hud-group-chip--hit { border-width: 1px; border-color: #7E1F12; }
.hud-group-chip--hit .hud-group-chip__pip { display: flex; background-color: #E02B2B; }
.hud-group-chip--flash { border-color: #E02B2B; background-color: rgba(224, 43, 43, 0.35); }
.hud-group-chip--lost { opacity: 0.45; }
.hud-group-chip--lost .hud-group-chip__digit { color: var(--tw-text-mute); }
