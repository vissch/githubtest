/* Battle HUD layout: where each region sits and how it is laid out inside. Nothing about colour or texture lives
   here (dustfront.uss), and the UXML carries no positions. The owner's decision keeps today's positions (silver
   top-left, bar along the bottom, minimap top-right, orders on the trenches); the faithful Dust Front arrangement
   (left card column, gauge cluster beside the radar, objectives top-left) is a second copy of this sheet. */

.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-region { position: absolute; }
.hud-region--topleft { left: 12px; top: 12px; flex-direction: column; align-items: flex-start; }
.hud-region--topright { right: 14px; top: 12px; flex-direction: column; align-items: flex-end; }
.hud-region--bottom { left: 0; right: 0; bottom: 0; height: var(--tw-bar-height); flex-direction: row; justify-content: center; align-items: flex-end; }

/* gauges and objectives, top-left */
.hud-gauges { width: 256px; padding: 8px 12px 4px 12px; flex-direction: column; }
.hud-objectives { width: 256px; margin-top: 8px; padding: 8px 12px 8px 12px; }
.hud-objectives__title { margin-bottom: 6px; color: var(--tw-text); -unity-font-style: bold; }
.hud-objectives__list { flex-direction: column; }
.hud-objective { flex-direction: row; align-items: center; min-height: 22px; }
.hud-objective__name { font-size: var(--tw-size-caption); flex-grow: 1; }
.hud-objective__progress { font-size: var(--tw-size-caption); color: var(--tw-accent); margin-left: 8px; min-width: 40px; -unity-text-align: middle-right; }
.hud-objectives.is-empty { display: none; }

/* minimap and speed, top-right */
.hud-bezel { padding: var(--tw-minimap-bezel); background-color: var(--tw-plate-700); border-radius: var(--tw-radius-lg); }
.hud-bezel--square { background-image: url("../../Skin/Sprites/minimap_frame.png"); -unity-slice-left: 24; -unity-slice-top: 24; -unity-slice-right: 24; -unity-slice-bottom: 24; -unity-slice-scale: 1px; }
.hud-bezel--round { background-image: url("../../Skin/Sprites/bezel_round.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0; border-radius: 50%; overflow: hidden; }
.hud-minimap { background-color: var(--tw-plate-900); width: 100px; height: 60px; border-radius: var(--tw-radius-sm); overflow: hidden; }   /* size set in code from the map */
.hud-minimap__layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.hud-minimap__view { position: absolute; border-width: 1px; border-color: rgba(200, 201, 198, 0.8); width: 8px; height: 6px; }
.hud-speed { margin-top: 8px; padding: 6px; flex-direction: row; }
.hud-speed__btn { width: 40px; height: 40px; min-height: 0; padding: 0; margin-left: 4px; font-size: var(--tw-size-caption); background-image: url("../../Skin/Sprites/row_plate.png"); -unity-slice-left: 12; -unity-slice-top: 8; -unity-slice-right: 12; -unity-slice-bottom: 8; border-radius: var(--tw-radius); }
.hud-speed__btn.tw-btn--on { background-color: #2C2E33; border-bottom-width: 2px; border-bottom-color: var(--tw-accent); color: var(--tw-accent-bright); }
.hud-speed__btn > .tw-icon { width: 18px; height: 18px; align-self: center; }

/* the bar, bottom centre */
.hud-bar { flex-shrink: 0; flex-direction: row; align-items: flex-end; padding: 6px var(--tw-bar-inset) 8px var(--tw-bar-inset); height: var(--tw-bar-height); margin-bottom: 0; }
/* the infantry stand as tall as the ARMOUR row over the SUPPORT row (HudLayout.StackHeightPx); caption top, cards bottom */
.hud-group--infantry { height: 182px; justify-content: space-between; }
.hud-group-stack { flex-direction: column; margin-left: var(--tw-card-gap); }
.hud-group--support { margin-top: 6px; }
.hud-cards--infantry .tw-card { width: var(--tw-card-size-infantry); height: var(--tw-card-size-infantry); }
.hud-cards--infantry .tw-card__portrait { left: 8px; top: 8px; right: 8px; bottom: 8px; }
.hud-cards--infantry .tw-card__nameplate { height: 22px; left: 4px; right: 4px; bottom: 4px; font-size: 15px; }
.hud-cards--infantry .tw-card__cost { height: 24px; right: 4px; top: 4px; padding: 0 6px; font-size: 17px; }
.hud-cards--infantry .tw-card__hotkey { height: 22px; min-width: 22px; left: 4px; top: 4px; font-size: 14px; }
.hud-cards--infantry .tw-card__weapon { width: 26px; height: 26px; left: 6px; bottom: 30px; }
.hud-cards--infantry .tw-card__badge { height: 22px; min-width: 24px; right: 4px; bottom: 30px; font-size: 14px; }
.hud-cards--infantry .tw-card__lock { left: 40px; top: 40px; right: 40px; bottom: 40px; }
.hud-group { flex-direction: column; align-items: flex-start; }
.hud-group__caption { height: 14px; margin: 0 0 2px 10px; font-size: var(--tw-size-micro); color: var(--tw-text); -unity-font-style: bold; }
.hud-cards { flex-direction: row; }
/* a gap before every card but each group's first (USS has no :first-child/:last-child; HudView marks the first) */
.hud-cards > .hud-card-slot { flex-shrink: 0; margin-left: var(--tw-card-gap); }
.hud-cards > .hud-card-slot.hud-card-slot--first { margin-left: 0; }
/* a card gap then the divider, as BattleHud laid out its cells: HudLayout.BarWidth counts both */
.hud-bar__divider { width: var(--tw-bar-divider); margin: 0 0 0 var(--tw-card-gap); height: 170px; background-color: rgba(0, 0, 0, 0); background-image: none; align-items: center; justify-content: center; }
.hud-card { }
.hud-tooltip { position: absolute; bottom: 206px; left: 50%; translate: -50% 0; display: none; }
.hud-tooltip.is-visible { display: flex; }
.hud-hint { position: absolute; bottom: 204px; left: 0; right: 0; -unity-text-align: middle-center; color: var(--tw-text-bright); display: none; }
.hud-hint.is-visible { display: flex; }

/* trench order clusters */
.hud-orders-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-orders { position: absolute; left: 0; top: 0; flex-direction: column; align-items: center; width: 340px; }
.hud-orders__row { flex-direction: row; align-items: center; }
.hud-orders__pair { flex-direction: row; padding: 4px; background-color: rgba(14, 15, 16, 0.86); border-width: 1px; border-color: #3A3D42; border-radius: var(--tw-radius-lg); }
.hud-orders__btn { margin-right: var(--tw-order-gap); }
.hud-orders__btn.hud-orders__btn--last { margin-right: 0; }   /* USS has no :last-child */
.hud-orders__btn > .tw-icon { width: 40px; height: 40px; }
.hud-orders__gap { width: 56px; height: var(--tw-order-btn); }   /* the pairs' 2 x (4 px padding + 1 px border) come out of the gap: the cluster stays 340 px */
.hud-orders__count { margin-top: 4px; }
.hud-orders.is-hidden { display: none; }
/* an order that cannot be given dims as a whole button, never as a grey glyph on a normal plate (round 6) */
.hud-orders__btn:disabled { opacity: 0.4; }
.hud-orders__btn:disabled > .tw-icon { -unity-background-image-tint-color: var(--tw-text-dim); }
.hud-orders__btn--holdfire.tw-btn--on > .tw-icon { -unity-background-image-tint-color: var(--tw-alarm); }
.hud-gauges__vs { margin-left: 6px; font-size: var(--tw-size-micro); color: var(--tw-text-dim); }
/* the enemy count is large enough to pass at 3:1 in rust (round 6) */
#enemy-value { font-size: 16px; -unity-font-style: bold; min-width: 40px; }

/* banner and pause plate, centre */
.hud-banner { position: absolute; left: 0; right: 0; top: 12%; align-items: center; display: none; }
.hud-banner.is-visible { display: flex; }
.hud-pause-plate { position: absolute; left: 50%; translate: -50% 0; top: 12px; padding: 6px 28px; display: none; }
.hud-pause-plate.is-visible { display: flex; }

/* the speaker strip, bottom-left above the roster bar (HudDialogue): portrait window, name, line */
/* the speaker strip sits in the bottom band beside the roster, its bottom on the card bottoms (round 5); where the
   roster is too wide to leave room (narrow screens) HudDialogue raises it above the bar with --raised. The name is
   bone for every speaker; a hurt report says so in a red status chip, and a critical one keylines the portrait. */
.hud-dialogue { position: absolute; left: 12px; bottom: 8px; width: 344px; min-height: 88px; flex-direction: row; align-items: center; padding: 6px 10px 6px 6px; }
.hud-dialogue--raised { bottom: 208px; }   /* over the bar: HudLayout.BarHeightPx + 12 */
.hud-dialogue__portrait { width: 80px; height: 80px; flex-shrink: 0; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; background-color: var(--tw-plate-900); border-radius: var(--tw-radius); border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.hud-dialogue__body { flex-grow: 1; flex-shrink: 1; justify-content: center; }
.hud-dialogue__head { flex-direction: row; align-items: center; margin-bottom: 2px; }
.hud-dialogue__name { color: var(--tw-text); font-size: var(--tw-size-caption); -unity-font-style: bold; }
.hud-dialogue__status { display: none; margin-left: 8px; font-size: 10px; color: var(--tw-text-bright); background-color: rgba(224, 43, 43, 0.2); border-width: 1px; border-color: var(--tw-alarm); border-radius: var(--tw-radius-sm); padding: 0 4px; }
.hud-dialogue__text { white-space: normal; color: var(--tw-text); font-size: 14px; margin: 0; padding: 0; -unity-paragraph-spacing: 0; }
.hud-dialogue.is-hurt .hud-dialogue__status { display: flex; }
.hud-dialogue.is-hurt .hud-dialogue__portrait { background-color: #2A1512; }
.hud-dialogue.is-critical .hud-dialogue__portrait { border-color: var(--tw-alarm); }
