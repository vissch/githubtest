<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- The battle HUD. Positions live in BattleHud.uss (the hud-region modifier rules), never here; the cards and the trench order
         clusters are instantiated from UnitCard.uxml / TrenchOrders.uxml by HudView.Build. Every layout layer is
         picking-mode Ignore so panel.Pick answers only for chrome: that is the click mask. -->
    <Style src="../../Skin/dustfront.uss" />
    <Style src="BattleHud.uss" />
    <ui:VisualElement name="hud-root" class="tw-hud hud-root" picking-mode="Ignore">

        <ui:VisualElement name="region-topleft" class="hud-region hud-region--topleft" picking-mode="Ignore">
            <ui:VisualElement name="gauges" class="tw-plate hud-gauges">
                <ui:VisualElement name="gauge-silver" class="tw-gauge">
                    <ui:VisualElement class="tw-gauge__icon tw-ico-silver" picking-mode="Ignore" />
                    <ui:Label name="silver-value" text="0" class="tw-window tw-digits tw-gauge__value" />
                    <ui:Label name="income-value" text="+0/s" class="tw-gauge__sub tw-mono" />
                </ui:VisualElement>
                <ui:VisualElement name="gauge-men" class="tw-gauge">
                    <ui:VisualElement class="tw-gauge__icon tw-ico-men" picking-mode="Ignore" />
                    <ui:Label name="men-value" text="0" class="tw-window tw-digits tw-gauge__value" />
                    <ui:Label text="VS" class="hud-gauges__vs" picking-mode="Ignore" />
                    <ui:Label name="enemy-value" text="0" class="tw-gauge__sub tw-mono tw-gauge__sub--alarm" />
                </ui:VisualElement>
                <ui:VisualElement name="gauge-time" class="tw-gauge">
                    <ui:VisualElement class="tw-gauge__icon tw-ico-clock" picking-mode="Ignore" />
                    <ui:Label name="time-value" text="00:00" class="tw-window tw-digits tw-gauge__value" />
                    <ui:Label name="speed-value" text="1x" class="tw-gauge__sub tw-mono" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="objectives" class="tw-plate hud-objectives">
                <ui:Label name="objectives-title" text="OBJECTIVES" class="tw-caption hud-objectives__title" />
                <ui:VisualElement name="objectives-list" class="hud-objectives__list" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="region-topright" class="hud-region hud-region--topright" picking-mode="Ignore">
            <ui:VisualElement name="minimap-bezel" class="hud-bezel hud-bezel--square">
                <ui:VisualElement name="minimap" class="hud-minimap">
                    <ui:VisualElement name="minimap-ground" class="hud-minimap__layer" picking-mode="Ignore" />
                    <ui:VisualElement name="minimap-dots" class="hud-minimap__layer" picking-mode="Ignore" />
                    <ui:VisualElement name="minimap-view" class="hud-minimap__view" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="speed-bar" class="tw-plate hud-speed">
                <ui:Button name="speed-pause" class="tw-btn tw-btn--icon hud-speed__btn" text=""><ui:VisualElement class="tw-icon tw-ico-pause" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="speed-1" text="1x" class="tw-btn hud-speed__btn" />
                <ui:Button name="speed-2" text="2x" class="tw-btn hud-speed__btn" />
                <ui:Button name="speed-4" text="4x" class="tw-btn hud-speed__btn" />
                <ui:Button name="speed-8" text="8x" class="tw-btn hud-speed__btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="region-bottom" class="hud-region hud-region--bottom" picking-mode="Ignore">
            <ui:VisualElement name="tooltip" class="tw-tooltip hud-tooltip" picking-mode="Ignore">
                <ui:Label name="tooltip-title" text="" class="tw-tooltip__heading" />
                <ui:Label name="tooltip-body" text="" class="tw-tooltip__body" />
                <ui:Label name="tooltip-cost" text="" class="tw-tooltip__cost" />
            </ui:VisualElement>
            <ui:VisualElement name="bar" class="tw-plate tw-plate--riveted hud-bar">
                <ui:VisualElement name="group-infantry" class="hud-group">
                    <ui:Label name="caption-infantry" text="INFANTRY" class="tw-caption hud-group__caption" />
                    <ui:VisualElement name="roster-infantry" class="hud-cards" />
                </ui:VisualElement>
                <ui:VisualElement class="tw-divider hud-bar__divider" picking-mode="Ignore" />
                <ui:VisualElement name="group-armour" class="hud-group">
                    <ui:Label name="caption-armour" text="ARMOUR" class="tw-caption hud-group__caption" />
                    <ui:VisualElement name="roster-armour" class="hud-cards" />
                </ui:VisualElement>
                <ui:VisualElement class="tw-divider hud-bar__divider" picking-mode="Ignore" />
                <ui:VisualElement name="group-support" class="hud-group">
                    <ui:Label name="caption-support" text="SUPPORT" class="tw-caption hud-group__caption" />
                    <ui:VisualElement name="support" class="hud-cards" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="hint" text="" class="tw-caption hud-hint" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="dialogue" class="tw-plate hud-dialogue" picking-mode="Ignore">
            <ui:VisualElement name="dialogue-portrait" class="tw-window hud-dialogue__portrait" picking-mode="Ignore" />
            <ui:VisualElement class="hud-dialogue__body" picking-mode="Ignore">
                <ui:Label name="dialogue-name" text="" class="tw-caps hud-dialogue__name" picking-mode="Ignore" />
                <ui:Label name="dialogue-text" text="" class="tw-body hud-dialogue__text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="orders-layer" class="hud-orders-layer" picking-mode="Ignore" />

        <ui:VisualElement name="banner" class="hud-banner" picking-mode="Ignore">
            <ui:Label name="banner-text" text="" class="tw-banner" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="pause-plate" class="tw-plate hud-pause-plate" picking-mode="Ignore">
            <ui:Label name="pause-text" text="PAUSED" class="tw-h2 tw-accent" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
