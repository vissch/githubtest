<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- The Home Front (docs/21 phase 6): the city diorama shows through a clear screen; the buildings on the left
         (built by HomeFrontScreen), the chosen one's plate on the right with its stage, EXPAND and its upgrade lines.
         Containers ignore picking so the diorama can be clicked between the plates. Loaded from Resources. -->
    <Style src="../../Skin/dustfront.uss" />
    <Style src="../../Shell/Shell.uss" />
    <ui:VisualElement name="homefront-screen" class="tw-screen shell-screen shell-screen--clear" picking-mode="Ignore">
        <ui:VisualElement class="tw-topstrip shell-topstrip" picking-mode="Ignore">
            <ui:Label text="HOME FRONT" class="tw-topstrip__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="gold-readout" class="campaign-gold" picking-mode="Ignore">
            <ui:Label text="GOLD" class="tw-caption campaign-gold__label" picking-mode="Ignore" />
            <ui:Label name="gold-value" text="0" class="tw-h2 tw-accent campaign-gold__value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="campaign-content" picking-mode="Ignore">
            <ui:VisualElement class="tw-panel campaign-side">
                <ui:VisualElement name="faction-tabs" class="campaign-tabs" />
                <ui:Label text="BUILDINGS" class="tw-caption shell-section" />
                <ui:VisualElement name="building-list" class="tw-list" />
            </ui:VisualElement>
            <ui:VisualElement name="building-info" class="tw-panel tw-info-panel campaign-info">
                <ui:Label name="info-title" text="" class="tw-h2 tw-header-window shell-info-header" />
                <ui:Label name="info-blurb" text="" class="tw-body tw-info-panel__body" />
                <ui:Label name="stage-label" text="" class="tw-caption campaign-stage" />
                <ui:VisualElement class="campaign-line">
                    <ui:Button name="btn-expand" text="EXPAND" class="tw-btn tw-btn--primary" />
                    <ui:Label name="expand-cost" text="" class="tw-caption campaign-chip" />
                </ui:VisualElement>
                <ui:Label text="UPGRADE LINES" class="tw-caption shell-section" />
                <ui:VisualElement name="lines-list" class="tw-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="shell-bottom-row" picking-mode="Ignore">
            <ui:Button name="btn-back" text="BACK" class="tw-btn tw-btn--wide" />
            <ui:Button name="btn-front" text="TO THE FRONT" class="tw-btn tw-btn--wide tw-btn--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
