<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- The box for the owner's words after F10 (FeedbackScreen): a plate low on the screen over the held match. No
         tw-screen on it: that class paints the whole screen, and he is writing about what he sees.
         Loaded from Resources, so no ShellAssets field. The root takes the pointer (picking-mode Position): while he
         types, a click beside the plate reaches no button of a menu under the box. -->
    <Style src="../../Skin/dustfront.uss" />
    <Style src="../../Shell/Shell.uss" />
    <ui:VisualElement name="feedback-screen" class="shell-screen shell-feedback" picking-mode="Position">
        <ui:VisualElement name="feedback-plate" class="tw-panel shell-feedback__plate">
            <ui:VisualElement class="tw-hazard" picking-mode="Ignore" />
            <ui:Label name="feedback-title" text="CAPTURED" class="tw-h2 shell-feedback__title" />
            <ui:Label name="feedback-said" text="" class="tw-caption shell-feedback__said" />
            <ui:TextField name="feedback-note" multiline="true" class="tw-field shell-feedback__note" />
            <ui:VisualElement class="shell-confirm__row shell-feedback__row">
                <ui:Button name="btn-feedback-save" text="SAVE" class="tw-btn tw-btn--primary" />
                <ui:Button name="btn-feedback-close" text="CLOSE" class="tw-btn" />
            </ui:VisualElement>
            <ui:Label name="feedback-hint" text="" class="tw-caption shell-hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
