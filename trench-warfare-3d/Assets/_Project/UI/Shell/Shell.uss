/* Shell layout: where the menu, mission select, pause, settings and debrief put their plates. Skin comes from
   dustfront.uss; nothing here names a colour or a texture except the backdrop image the code assigns. */

.shell-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
.shell-backdrop { position: absolute; left: -5%; top: -5%; width: 110%; height: 110%; -unity-background-scale-mode: scale-and-crop; background-color: var(--tw-plate-900); }
.shell-topstrip { position: absolute; left: 0; right: 0; top: 0; }
.shell-title-block { position: absolute; top: 14%; left: 0; right: 0; align-items: center; }
.shell-title-block .tw-caption { margin-top: 8px; }
.shell-menu-stack { position: absolute; left: 50%; top: 42%; translate: -50% 0; flex-direction: column; align-items: stretch; width: 340px; }
.shell-menu-stack > .tw-btn { margin-bottom: 10px; }
.shell-bottom-row { position: absolute; left: 0; right: 0; bottom: 36px; flex-direction: row; justify-content: center; }
.shell-bottom-row > .tw-btn { margin: 0 8px; }

/* mission select */
.shell-content { position: absolute; left: 80px; right: 80px; top: 80px; bottom: 110px; flex-direction: row; }
.shell-list-column { width: 420px; margin-right: 24px; }
.shell-info-column { flex-grow: 1; }
.shell-info-header { margin-bottom: 8px; }
.shell-info-stats { white-space: normal; margin: 8px 0; }
.shell-difficulty { flex-direction: row; margin: 8px 0 4px 0; }
.shell-seed-row { flex-direction: row; align-items: center; margin-top: 8px; }
.shell-seed-row > .tw-caption { margin-right: 12px; }
.shell-seed-row > .tw-field { width: 140px; margin-right: 8px; }

/* pause, settings, debrief plates */
.shell-plate { min-width: 480px; padding: 24px 32px 20px 32px; align-items: stretch; }
.shell-plate__title { margin-bottom: 18px; -unity-text-align: middle-center; }
.shell-plate > .tw-btn { margin-bottom: 8px; }
.shell-confirm { margin-top: 12px; padding: 12px; align-items: center; }
.shell-confirm__text { margin-bottom: 10px; -unity-text-align: middle-center; white-space: normal; }
.shell-confirm__row { flex-direction: row; }
.shell-confirm__row > .tw-btn { margin: 0 6px; min-width: 120px; }
.shell-hint { margin-top: 14px; -unity-text-align: middle-center; }

.shell-settings { width: 1100px; height: 760px; }
.shell-tabs { flex-direction: row; margin-bottom: 10px; }
.shell-pages { flex-grow: 1; }
.shell-page { flex-grow: 1; }
.shell-page > .tw-row { margin-bottom: 4px; }
.shell-page .tw-slider { flex-grow: 1; }
.shell-page .tw-dropdown { flex-grow: 1; }
.shell-note { margin: 8px 12px; }
.shell-actions { flex-direction: row; justify-content: flex-end; margin-top: 12px; }
.shell-actions > .tw-btn { margin-left: 8px; min-width: 140px; }
.shell-section { margin: 12px 12px 4px 12px; }
.shell-controls-list { max-height: 420px; }

.shell-debrief { width: 820px; }
.shell-result { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 8px; }
.shell-result > .tw-stamp { margin-right: 20px; }
.shell-result-sub { -unity-text-align: middle-center; margin-bottom: 14px; }
.shell-debrief .tw-table { margin: 6px 0 14px 0; }
.shell-debrief .tw-table__cell--head { flex-basis: 0; }
.shell-debrief-meta { flex-direction: row; justify-content: space-between; margin-bottom: 12px; }

/* the armoury (ArmouryScreen): tiles of cutouts left; the chosen unit on the right, art beside its role, numbers,
   ranks and condition reports. Round 5: the stats are a label/value grid (not danger red), the ranks sit under the
   numbers and are readable, the condition faces are one row named as the game names them, and a tile's name sits
   under its art, never over it. Round 6: the cost fits (the tile was too short and clipped it), the ENEMY chip takes
   the cost's place instead of sitting on the art, the panel hugs its content, stat labels share the values' baseline. */
.armoury-list-column { width: 468px; }
.armoury-section { color: var(--tw-text); -unity-font-style: bold; font-size: 14px; }
.armoury-grid { flex-direction: row; flex-wrap: wrap; margin: 0 8px 8px 8px; }
.armoury-tile { width: 104px; height: 132px; margin: 0 8px 8px 0; padding: 6px 4px 4px 4px; flex-direction: column; align-items: center; justify-content: flex-start; background-image: none; background-color: var(--tw-plate-700); border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.armoury-tile:hover { border-color: var(--tw-text-dim); }
.armoury-tile.tw-list-row--selected { background-image: none; background-color: var(--tw-plate-600); border-color: var(--tw-accent); }
.armoury-tile__art { width: 92px; height: 68px; flex-shrink: 0; margin-bottom: 4px; -unity-background-scale-mode: scale-to-fit; }
.armoury-tile__name { margin: 0; padding: 0 0 2px 0; font-size: 12px; color: var(--tw-text); -unity-font-style: bold; -unity-text-align: middle-center; }
.armoury-tile__cost { margin: 0; padding: 0; font-size: var(--tw-size-caption); color: var(--tw-accent-bright); -unity-font-definition: url("../Skin/Fonts/DustFrontMono.asset"); -unity-text-align: middle-center; }
.armoury-tile__chip { margin: 1px 0 0 0; font-size: 10px; color: var(--tw-text); border-width: 1px; border-color: var(--tw-enemy); border-radius: var(--tw-radius-sm); padding: 0 4px; background-color: rgba(181, 82, 58, 0.3); -unity-text-align: middle-center; }
.armoury-info { padding: 16px 20px 20px 20px; align-self: flex-start; min-height: 530px; }   /* round 7: no jump between units */
.armoury-hero { flex-direction: row; }
.armoury-art { width: 340px; height: 340px; flex-shrink: 0; margin-right: 20px; -unity-background-scale-mode: scale-to-fit; background-color: var(--tw-plate-900); border-radius: var(--tw-radius-lg); }
.armoury-side { flex-grow: 1; flex-shrink: 1; }
.armoury-role { color: var(--tw-accent); margin-bottom: 4px; }
.armoury-subhead { margin: 14px 0 6px 0; color: var(--tw-text); -unity-font-style: bold; }
.armoury-note { color: var(--tw-text-dim); white-space: normal; margin-top: 4px; }
.armoury-note--hidden { display: none; }
.armoury-stats { margin-top: 10px; }
.armoury-stat { flex-direction: row; align-items: flex-end; height: 24px; }
.armoury-stat__label { padding-bottom: 4px; width: 110px; font-size: var(--tw-size-caption); color: var(--tw-text-dim); letter-spacing: 1px; }
.armoury-stat__value { font-size: var(--tw-size-num); color: var(--tw-text); -unity-font-definition: url("../Skin/Fonts/DustFrontMono.asset"); }
.armoury-stat__value--cost { color: var(--tw-accent-bright); }
.armoury-ranks { flex-direction: row; }
.armoury-rank { width: 170px; height: 60px; margin-right: 12px; flex-direction: row; align-items: center; padding: 0 12px; justify-content: flex-start; }
.armoury-rank__lock { width: 22px; height: 22px; flex-shrink: 0; margin-right: 10px; -unity-background-image-tint-color: rgba(200, 201, 198, 0.6); }
.armoury-rank__text { flex-shrink: 1; justify-content: center; }
.armoury-rank__label { margin: 0; padding: 0; color: var(--tw-text-dim); font-size: 14px; }
.armoury-rank__why { margin: 3px 0 0 0; padding: 0; color: var(--tw-text-dim); font-size: var(--tw-size-micro); white-space: nowrap; }
.armoury-states { flex-direction: row; }
.armoury-state { width: 80px; margin-right: 8px; flex-direction: column; align-items: center; }
.armoury-state__face { width: 80px; height: 80px; -unity-background-scale-mode: scale-to-fit; }
.armoury-state__label { margin-top: 4px; font-size: var(--tw-size-micro); color: var(--tw-text-dim); -unity-text-align: middle-center; letter-spacing: 1px; }
