diff --git a/trench-warfare-3d/Assets/_Project/Tests/EditMode/FlareAnchorTests.cs b/trench-warfare-3d/Assets/_Project/Tests/EditMode/FlareAnchorTests.cs
new file mode 100644
index 0000000..3f7ee8c
--- /dev/null
+++ b/trench-warfare-3d/Assets/_Project/Tests/EditMode/FlareAnchorTests.cs
@@ -0,0 +1,78 @@
+// Phase: C42 (AOSA, juice J03) - the rifle flare and the streak at the standard view. Pure logic, no scene: a streak
+// that leaves the muzzle keeps its tail on the muzzle on the first held frame where the old one had already slid metres
+// ahead of it, it ends where the old one ended, and the flare moved toward the eye stays on its line of sight (so it
+// covers the same pixels) and only pull metres nearer. With fx.flarePull 0 the card does not move at all.
+using NUnit.Framework;
+using UnityEngine;
+using TW.Presentation.Tactical;
+
+namespace TW.Tests
+{
+    public class FlareAnchorTests
+    {
+        const float TracerSeconds = 0.12f;   // CombatFx.TracerSeconds
+        const float Streak = 10f;            // the night streak (CombatFx.Update)
+        const float HeldStep = 1f / 64f;     // the held clock of a shot_tick run (C33)
+
+        [Test]
+        public void TheStreakGrowsOutOfTheMuzzle_AndEndsWhereTheOldOneEnded()
+        {
+            foreach (float len in new[] { 5f, 12f, 40f, 80f, 110f })
+            {
+                float streak = Mathf.Min(len, Streak);
+                for (int i = 0; i <= 100; i++)
+                {
+                    float k = i / 100f;
+                    CombatFx.StreakSpan(len, streak, k, out float tail, out float head);
+                    Assert.That(tail, Is.GreaterThanOrEqualTo(0f), "never behind the muzzle");
+                    Assert.That(head, Is.LessThanOrEqualTo(len + 1e-4f), "never past the man shot at");
+                    Assert.That(head - tail, Is.LessThanOrEqualTo(streak + 1e-4f).And.GreaterThan(0f));
+                    if (head <= streak) Assert.AreEqual(0f, tail, "the tail sits on the muzzle until the head is a streak out");
+                }
+                CombatFx.StreakSpan(len, streak, 1f, out float t1, out float h1);
+                Assert.AreEqual(len, h1, 1e-4f, "the head reaches the man at the end of the life");
+                Assert.AreEqual(len - streak, t1, 1e-4f, "and the streak ends where the old one ended");
+            }
+        }
+
+        [Test]
+        public void OnTheFirstHeldFrame_TheTailIsAtTheMuzzle_WhereTheOldOneWasMetresAhead()
+        {
+            // a shot is first drawn on the first held frame at or after its birth: its age there is anywhere in one step
+            foreach (float len in new[] { 40f, 80f, 110f })
+            {
+                float oldSum = 0f, newSum = 0f; int n = 64;
+                for (int i = 0; i < n; i++)
+                {
+                    float k = (i + 0.5f) / n * HeldStep / TracerSeconds;
+                    oldSum += k * (len - Streak);   // the old streak: born full length, its tail at k (len - streak)
+                    CombatFx.StreakSpan(len, Streak, k, out float tail, out _);
+                    newSum += tail;
+                }
+                Assert.That(oldSum / n, Is.GreaterThan(1.5f), len + " m: the old tail was not ahead of the muzzle");
+                Assert.That(newSum / n, Is.LessThan(0.25f * oldSum / n), len + " m: the new tail is not at the muzzle");
+            }
+        }
+
+        [Test]
+        public void TheFlareMovesTowardTheEye_OnItsLineOfSight()
+        {
+            var eye = new Vector3(10f, 33f, -70f);
+            var muzzle = new Vector3(12f, 1.9f, 4f);
+            float dist = Vector3.Distance(eye, muzzle);
+            var at = muzzle;
+            float keep = CombatFx.TowardEye(eye, ref at, 2.25f);
+            Assert.AreEqual(dist - 2.25f, Vector3.Distance(eye, at), 1e-3f, "pull metres nearer");
+            Assert.AreEqual((dist - 2.25f) / dist, keep, 1e-5f, "the size factor that keeps it the same on screen");
+            Assert.AreEqual(0f, Vector3.Cross((at - eye).normalized, (muzzle - eye).normalized).magnitude, 1e-5f, "on the same line of sight");
+
+            var near = new Vector3(10f, 30f, -66f);
+            float half = CombatFx.TowardEye(eye, ref near, 50f);
+            Assert.AreEqual(0.5f, half, 1e-6f, "never more than half the way to the eye");
+
+            var still = muzzle;
+            Assert.AreEqual(1f, CombatFx.TowardEye(eye, ref still, 0f), "pull 0: the old path");
+            Assert.AreEqual(muzzle, still);
+        }
+    }
+}
