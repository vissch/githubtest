+// Phase: C2 (AOSA C49, 2026-09-25) - the men's fake shadow map (CrowdShade) is pure arithmetic until the upload: a man
+// darkens the texel he stands on and nothing beyond his footprint's reach, the footprint leans away from the light,
+// crowds add up to full and no further, the map's outer ring stays empty for the skirt, and with no men (or the knob
+// off, the default) nothing is written at all.
+using NUnit.Framework;
+using Unity.Collections;
+using Unity.Mathematics;
+using TW.Presentation;
+using TW.Presentation.Units;
+
+namespace TW.Tests
+{
+    public class CrowdShadeTests
+    {
+        const float Cell = CrowdShade.CellMeters;
+        const int W = 40, H = 30;
+
+        NativeArray<byte> stamps, texels;
+        NativeArray<int2> spans, rows;
+
+        [SetUp] public void SetUp() { Knobs.Clear(); texels = new NativeArray<byte>(W * H, Allocator.Persistent); }
+
+        [TearDown]
+        public void TearDown()
+        {
+            Knobs.Clear();
+            if (texels.IsCreated) texels.Dispose();
+            if (stamps.IsCreated) stamps.Dispose();
+            if (spans.IsCreated) spans.Dispose();
+            if (rows.IsCreated) rows.Dispose();
+        }
+
+        /// <summary>Near men from the front of the array, far men from its back, as VATRenderer's fill lays them out.</summary>
+        void Splat(float radius, float stretch, float2 down, float3[] near, float3[] far = null)
+        {
+            far = far ?? new float3[0];
+            int k = CrowdShade.BuildStamps(radius, stretch, down, Cell, ref stamps, ref spans, ref rows);
+            var men = new NativeArray<VatInstance>(near.Length + far.Length + 5, Allocator.Temp);
+            for (int i = 0; i < men.Length; i++) men[i] = new VatInstance { Pos = new float3(-999f, 0f, -999f) };   // the unused middle must never be read
+            for (int i = 0; i < near.Length; i++) men[i] = new VatInstance { Pos = near[i] };
+            for (int i = 0; i < far.Length; i++) men[men.Length - far.Length + i] = new VatInstance { Pos = far[i] };
+            // the unused middle holds men on the map too: if the job read them, texels would show it
+            for (int i = near.Length; i < men.Length - far.Length; i++) men[i] = new VatInstance { Pos = new float3(10.25f, 0f, 2.25f) };
+            new CrowdShade.SplatJob { Men = men, NearCount = near.Length, FarCount = far.Length, Stamps = stamps, Spans = spans, Rows = rows, K = k, W = W, H = H, InvCell = 1f / Cell, Texels = texels }.Execute();
+            men.Dispose();
+        }
+
+        byte At(int x, int z) => texels[z * W + x];
+        static float2 Centre(int x, int z) => new float2((x - 0.5f) * Cell, (z - 0.5f) * Cell);
+
+        [Test]
+        public void StandardMap_IsHalfMetreTexels_UnderHundredKilobytes()
+        {
+            CrowdShade.GridFor(new float2(90f, 240f), out float cell, out int w, out int h);
+            Assert.AreEqual(0.5f, cell);
+            Assert.AreEqual(182, w); Assert.AreEqual(482, h);
+            Assert.Less(w * h, 100 * 1024);
+            CrowdShade.GridFor(new float2(1000f, 1000f), out cell, out w, out h);
+            Assert.LessOrEqual(w * h, CrowdShade.MaxTexels * 1.02f, "a big map gets coarser texels, not a bigger upload");
+            var st = CrowdShade.UvTransform(0.5f, 182, 482);
+            // texel 41's centre, (41 - 0.5) x 0.5 = 20.25 m, samples at uv (41 + 0.5) / 182
+            Assert.AreEqual((41 + 0.5f) / 182f, 20.25f * st.x + st.z, 1e-6f);
+        }
+
+        [Test]
+        public void OneMan_DarkensHisTexel_AndNothingBeyondHisReach()
+        {
+            const float radius = 0.6f;
+            var man = new float3(10.25f, 0f, 7.25f);   // the centre of texel (21, 15)
+            Splat(radius, 1f, float2.zero, new[] { man });
+            byte peak = At(21, 15);
+            Assert.Greater(peak, (byte)150, "under his feet the shade is near PerMan");
+            for (int z = 0; z < H; z++)
+            for (int x = 0; x < W; x++)
+            {
+                float d = math.distance(Centre(x, z), man.xz);
+                if (d > radius + Cell * 0.25f) Assert.AreEqual(0, At(x, z), $"texel {x},{z} is {d} m away");
+                else Assert.LessOrEqual(At(x, z), peak);
+            }
+            Assert.Greater(At(22, 15), 0); Assert.Greater(At(21, 16), 0);
+        }
+
+        [Test]
+        public void Stamp_MatchesTheFootprint_AtTheQuantisedPosition()
+        {
+            const float radius = 0.9f, stretch = 1.6f;
+            var down = CrowdShade.Quantize(new float2(0.6f, -0.8f));
+            var man = new float3(7.30f, 0f, 6.10f);
+            Splat(radius, stretch, down, new[] { man });
+            // he is stamped as if he stood at the centre of his quarter of the texel
+            float fx = man.x / Cell + 0.5f, fz = man.z / Cell + 0.5f;
+            int bx = (int)fx, bz = (int)fz;
+            float qx = bx + ((int)((fx - bx) * 4) + 0.5f) / 4f, qz = bz + ((int)((fz - bz) * 4) + 0.5f) / 4f;
+            for (int z = bz - 3; z <= bz + 3; z++)
+            for (int x = bx - 3; x <= bx + 3; x++)
+            {
+                float f = CrowdShade.Footprint(new float2((x - qx) * Cell, (z - qz) * Cell), radius, stretch, down);
+                Assert.AreEqual((double)(int)(f * CrowdShade.PerMan * 255f + 0.5f), (double)At(x, z), 1.0, $"texel {x},{z}");   // 1: Mono may round a half the other way
+            }
+        }
+
+        [Test]
+        public void Footprint_LeansAwayFromTheLight()
+        {
+            var down = new float2(1f, 0f);
+            Assert.Greater(CrowdShade.Footprint(new float2(0.8f, 0f), 0.5f, 1.8f, down), 0f, "downlight, past the radius, still shaded");
+            Assert.AreEqual(0f, CrowdShade.Footprint(new float2(-0.8f, 0f), 0.5f, 1.8f, down), "uplight, past the radius, not");
+            Assert.AreEqual(0f, CrowdShade.Footprint(new float2(0f, 0.51f), 0.5f, 1.8f, down), "across the light it is only radius wide");
+            Assert.AreEqual(0f, CrowdShade.Footprint(new float2(0.5f * (2f * 1.8f - 1f) + 0.01f, 0f), 0.5f, 1.8f, down), "zero past Reach");
+            Assert.AreEqual(0.5f * (2f * 1.8f - 1f), CrowdShade.Reach(0.5f, 1.8f, down), 1e-6f);
+
+            var man = new float3(10.25f, 0f, 7.25f);
+            Splat(0.6f, 1.8f, down, new[] { man });
+            Assert.Greater(At(23, 15), At(19, 15), "a metre downlight is darker than a metre uplight");
+        }
+
+        [Test]
+        public void Crowd_AddsUp_AndSaturates()
+        {
+            var man = new float3(10.25f, 0f, 7.25f);
+            Splat(0.6f, 1f, float2.zero, new[] { man });
+            int one = At(21, 15);
+            Splat(0.6f, 1f, float2.zero, new[] { man, man });
+            Assert.AreEqual(math.min(255, one * 2), At(21, 15));
+            Splat(0.6f, 1f, float2.zero, new[] { man, man, man, man });
+            Assert.AreEqual(255, At(21, 15));
+        }
+
+        [Test]
+        public void FarTier_IsStamped_TheUnusedMiddleIsNot()
+        {
+            var farMan = new float3(15.25f, 0f, 10.25f);   // texel (31, 21)
+            Splat(0.6f, 1f, float2.zero, new float3[0], new[] { farMan });
+            Assert.Greater(At(31, 21), 0);
+            Assert.AreEqual(0, At(21, 5), "the slots between the tiers hold a man at texel (21, 5), never read");
+        }
+
+        [Test]
+        public void EdgeRing_StaysEmpty_OffMapMenIgnored()
+        {
+            Splat(0.8f, 1f, float2.zero, new[] { new float3(0.05f, 0f, 0.05f), new float3(W * Cell - 0.6f, 0f, H * Cell - 0.6f), new float3(-40f, 0f, 3f), new float3(float.NaN, 0f, 3f), new float3(1e9f, 0f, 1e9f) });
+            for (int x = 0; x < W; x++) { Assert.AreEqual(0, At(x, 0)); Assert.AreEqual(0, At(x, H - 1)); }
+            for (int z = 0; z < H; z++) { Assert.AreEqual(0, At(0, z)); Assert.AreEqual(0, At(W - 1, z)); }
+            Assert.Greater(At(1, 1), 0, "the corner man still shades the first texel inside the ring");
+        }
+
+        [Test]
+        public void NoMen_ClearsTheMap_AndTheKnobIsOffByDefault()
+        {
+            for (int i = 0; i < texels.Length; i++) texels[i] = 77;
+            Splat(0.6f, 1.5f, new float2(0f, 1f), new float3[0]);
+            for (int i = 0; i < texels.Length; i++) Assert.AreEqual(0, texels[i]);
+            Assert.IsFalse(CrowdShade.ReadEnabled(), "off unless vat.crowdShadow is set");
+            Knobs.Parse("vat.crowdShadow=1");
+            Assert.IsTrue(CrowdShade.ReadEnabled());
+        }
+
+        /// <summary>C49b: the kit takes the shade by default once the map is live (0 until the first upload, so nothing
+        /// darkens before there is a map), vat.crowdShadowKit=0 is C49's ground only, and Dispose clears both globals.</summary>
+        [TestCase(null, 1f)]
+        [TestCase("vat.crowdShadowKit=0", 0f)]
+        public void KitGlobal_FollowsTheKnob_OnlyWhileLive(string knob, float expected)
+        {
+            if (knob != null) Knobs.Parse(knob);
+            var men = new NativeArray<VatInstance>(1, Allocator.Persistent);
+            men[0] = new VatInstance { Pos = new float3(5f, 0f, 5f) };
+            var shade = new CrowdShade(new float2(20f, 20f));
+            try
+            {
+                Assert.AreEqual(0f, UnityEngine.Shader.GetGlobalFloat("_TWCrowdShade"), "nothing darkens before the first upload");
+                shade.Begin(men, 1, 0, 1.5f);
+                shade.End();
+                Assert.AreEqual(1, shade.Uploads);
+                Assert.AreEqual(CrowdShade.Strength, UnityEngine.Shader.GetGlobalFloat("_TWCrowdShade"), 1e-6f);
+                Assert.AreEqual(expected, UnityEngine.Shader.GetGlobalFloat("_TWCrowdShadeKit"), 1e-6f);
+            }
+            finally { shade.Dispose(); men.Dispose(); }
+            Assert.AreEqual(0f, UnityEngine.Shader.GetGlobalFloat("_TWCrowdShade"));
+            Assert.AreEqual(0f, UnityEngine.Shader.GetGlobalFloat("_TWCrowdShadeKit"));
+        }
+    }
+}
