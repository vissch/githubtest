diff --git a/trench-warfare-3d/Assets/_Project/Presentation/Units/CrowdShade.cs b/trench-warfare-3d/Assets/_Project/Presentation/Units/CrowdShade.cs
new file mode 100644
index 0000000..aeb8002
--- /dev/null
+++ b/trench-warfare-3d/Assets/_Project/Presentation/Units/CrowdShade.cs
@@ -0,0 +1,287 @@
+// Phase: C2 (AOSA C49, 2026-09-25) - the men's fake shadow: a small map of the ground under the crowd, splatted on the
+// CPU and read by the ground's own shader, instead of a second pass over the men.
+// Real shadows on the men (VATRenderer casts when near vertices x 2 + far fit vat.vertexBudget) double the VAT
+// vertices at 1,500 a side and cost about 0.3 ms of GPU (AOSA A07). This costs no draw and no vertex. Every man drawn
+// this frame stamps a soft footprint into an R8 map of the battlefield (0.5 m a texel: 182 x 482 = 86 KB on the
+// standard 90 x 240 m map). The footprint is an ellipse stretched away from the key light, with the man standing in
+// its uplight end, and it grows with the drawn man (VATRenderer's zoom growth). TW/Toon multiplies the ground's albedo
+// by 1 - vat.crowdShadowStrength x that map, so it reads as contact shade and ambient occlusion, not as a projected
+// shadow. Two men side by side add up, to full strength at most.
+// C49b (cycle 5): the men mostly stand on duckboards and sandbag steps, painted TW/Toon kit, not on the ground, so the
+// ground-only shade of C49 changed 0.002% of the standard view (a0017). With vat.crowdShadowKit 1 (the default) every
+// TW/Toon surface takes the shade by how much it faces up; 0 is C49's ground only.
+// Cadence: re-splatted and uploaded vat.crowdShadowUpdateHz times a second of real time (0 = every frame). A man walks
+// about 1.5 m/s, so at 15 Hz his footprint trails him by 0.1 m at most, a fifth of a texel. While the clock is held
+// (PerfBench's image runs set Time.captureDeltaTime) it runs every frame, so a still repeats. The splat is a Burst job
+// on a worker, scheduled as soon as VATRenderer's fill has written the frame's records and completed at the end of the
+// same LateUpdate, so the main thread pays for the schedule and the 86 KB upload, and the frame shows its own men.
+// Off (knob vat.crowdShadow 0, the default) this class is never built: _TWCrowdShade stays 0, the shader's branch is
+// never taken, and the ground draws exactly as before.
+// The map's outer ring of texels is never written. The painted skirt beyond the map edge uses the ground's material,
+// and the clamped sampler repeats that ring out to the horizon.
+using Unity.Burst;
+using Unity.Collections;
+using Unity.Jobs;
+using Unity.Mathematics;
+using Unity.Profiling;
+using UnityEngine;
+
+namespace TW.Presentation.Units
+{
+    public sealed class CrowdShade : System.IDisposable
+    {
+        /// <summary>Metres a texel on a map up to MaxTexels; a larger map gets coarser texels, never a larger upload.</summary>
+        public const float CellMeters = 0.5f;
+        public const int MaxTexels = 131072;
+        /// <summary>Sub-texel positions a footprint is stamped at, each way: a man moves in 1/Phases-texel steps (0.125 m).</summary>
+        public const int Phases = 4;
+        /// <summary>The defaults of the knobs vat.crowdShadowStrength, vat.crowdShadowRadius (metres, for a life-size man),
+        /// vat.crowdShadowStretch (1 = a round blob centred on him) and vat.crowdShadowUpdateHz.</summary>
+        public const float Strength = 0.45f, Radius = 0.4f, Stretch = 1.5f, UpdateHz = 15f;
+        /// <summary>The default of the knob vat.crowdShadowKit: 1 = the up-facing kit takes the shade too, 0 = the ground only.</summary>
+        public const float Kit = 1f;
+        /// <summary>How much of the full shade one man's footprint reaches at its centre: a lone man is lighter than a crowd.</summary>
+        public const float PerMan = 0.7f;
+
+        static readonly int MapId = Shader.PropertyToID("_TWCrowdShadeMap"), StId = Shader.PropertyToID("_TWCrowdShadeST"), StrengthId = Shader.PropertyToID("_TWCrowdShade"), KitId = Shader.PropertyToID("_TWCrowdShadeKit");
+        static readonly ProfilerMarker Marker = new ProfilerMarker("TW.Vat.CrowdShade");
+
+        /// <summary>The knob vat.crowdShadow: 1 builds the map, 0 (default) leaves the ground exactly as before.</summary>
+        public static bool ReadEnabled() => Knobs.Get("vat.crowdShadow", false);
+
+        public readonly int W, H;
+        public readonly float Cell;
+        public readonly float2 Size;
+        readonly float strength, radius, stretch, updateHz, kit;
+        Texture2D tex;
+        NativeArray<byte> texels, stamps;
+        NativeArray<int2> spans, rows;
+        JobHandle pending;
+        bool scheduled;
+        int k;
+        float stampScale = float.NaN;
+        float2 stampDown = new float2(float.NaN, float.NaN);
+        double lastUpdate = double.NegativeInfinity;
+        bool uploadedEmpty, live;
+        Light key;
+        int keySearch;
+
+        /// <summary>Uploads so far (tests, stats).</summary>
+        public int Uploads { get; private set; }
+        public int UploadBytes => W * H;
+
+        /// <summary>The texel size and map dimensions for a battlefield: one ring of empty texels round the map.</summary>
+        public static void GridFor(float2 size, out float cell, out int w, out int h)
+        {
+            cell = math.max(CellMeters, math.sqrt(math.max(1f, size.x * size.y) / MaxTexels) * 1.05f);
+            w = (int)math.ceil(size.x / cell) + 2;
+            h = (int)math.ceil(size.y / cell) + 2;
+        }
+
+        /// <summary>World xz to map uv: uv = xz * st.xy + st.zw. Texel i's centre is at (i - 0.5) x cell.</summary>
+        public static Vector4 UvTransform(float cell, int w, int h) => new Vector4(1f / (cell * w), 1f / (cell * h), 1f / w, 1f / h);
+
+        public CrowdShade(float2 size)
+        {
+            strength = math.clamp(Knobs.Get("vat.crowdShadowStrength", Strength), 0f, 1f);
+            radius = math.clamp(Knobs.Get("vat.crowdShadowRadius", Radius), 0.05f, 1.5f);
+            stretch = math.clamp(Knobs.Get("vat.crowdShadowStretch", Stretch), 1f, 3f);
+            updateHz = math.max(0f, Knobs.Get("vat.crowdShadowUpdateHz", UpdateHz));
+            kit = math.clamp(Knobs.Get("vat.crowdShadowKit", Kit), 0f, 1f);
+            Size = size;
+            GridFor(size, out Cell, out W, out H);
+            texels = new NativeArray<byte>(W * H, Allocator.Persistent);
+            tex = new Texture2D(W, H, TextureFormat.R8, false, true) { name = "Crowd shade", wrapMode = TextureWrapMode.Clamp, filterMode = FilterMode.Bilinear, hideFlags = HideFlags.HideAndDontSave };
+            Shader.SetGlobalTexture(MapId, tex);
+            Shader.SetGlobalVector(StId, UvTransform(Cell, W, H));
+            Shader.SetGlobalFloat(StrengthId, 0f);   // until the first upload
+        }
+
+        public bool Fits(float2 size) => size.x == Size.x && size.y == Size.y;
+
+        /// <summary>
+        /// Starts a re-splat when one is due. men: VATRenderer's records, the near tier in [0, near), the far tier in the
+        /// last far slots; the job only reads them, and End must run before anything writes them again. scale: the drawn
+        /// scale of a man this frame (UnitScale x zoom growth).
+        /// </summary>
+        public void Begin(NativeArray<VatInstance> men, int near, int far, float scale)
+        {
+            using var perf = Marker.Auto();
+            End();
+            bool held = Time.captureDeltaTime > 0f;   // PerfBench's held clock: every frame, so a still repeats
+            double now = Time.realtimeSinceStartupAsDouble;
+            if (!held && updateHz > 0f && now - lastUpdate < 1.0 / updateHz) return;
+            lastUpdate = now;
+            if (near + far == 0 && uploadedEmpty) return;   // nothing drawn, and the map already says so
+            float2 down = Downlight();
+            if (!stamps.IsCreated || scale != stampScale || math.any(down != stampDown))
+            {
+                k = BuildStamps(radius * scale, stretch, down, Cell, ref stamps, ref spans, ref rows);
+                stampScale = scale; stampDown = down;
+            }
+            pending = new SplatJob { Men = men, NearCount = near, FarCount = far, Stamps = stamps, Spans = spans, Rows = rows, K = k, W = W, H = H, InvCell = 1f / Cell, Texels = texels }.Schedule();
+            scheduled = true;
+            uploadedEmpty = near + far == 0;
+        }
+
+        /// <summary>Waits for the splat Begin started, if any, and uploads it: the same frame, before it renders.</summary>
+        public void End()
+        {
+            if (!scheduled) return;
+            using var perf = Marker.Auto();
+            pending.Complete();
+            scheduled = false;
+            tex.SetPixelData(texels, 0);
+            tex.Apply(false, false);
+            Uploads++;
+            if (!live) { Shader.SetGlobalFloat(StrengthId, strength); Shader.SetGlobalFloat(KitId, kit); live = true; }
+        }
+
+        /// <summary>The way a shadow falls on the ground, unit length in xz; zero when there is no key light or it is overhead.
+        /// Atmosphere turns every directional light the same way, so any one of them will do.</summary>
+        float2 Downlight()
+        {
+            var sun = RenderSettings.sun;
+            if (sun == null || sun.type != LightType.Directional)
+            {
+                if (key == null && keySearch++ % 60 == 0)
+                    foreach (var l in Object.FindObjectsByType<Light>(FindObjectsSortMode.None))
+                        if (l.type == LightType.Directional) { key = l; break; }
+                sun = key;
+            }
+            if (sun == null) return float2.zero;
+            Vector3 f = sun.transform.forward;
+            return Quantize(new float2(f.x, f.z));
+        }
+
+        /// <summary>The direction to within about half a degree, so a light that barely moves does not rebuild the stamps.</summary>
+        public static float2 Quantize(float2 d)
+        {
+            float len = math.length(d);
+            if (len < 0.05f) return float2.zero;
+            float a = math.round(math.atan2(d.y, d.x) * (720f / (2f * math.PI))) * (2f * math.PI / 720f);
+            return new float2(math.cos(a), math.sin(a));
+        }
+
+        /// <summary>
+        /// How dark one man makes the ground at d (metres from his feet, xz), 0..1. An ellipse radius x stretch long and
+        /// radius wide along downlight, its centre pushed downlight by (stretch - 1) x radius so he stands inside its
+        /// uplight end, falling off smoothly to exactly 0 at its rim. downlight zero: a round blob centred on him.
+        /// </summary>
+        public static float Footprint(float2 d, float radius, float stretch, float2 downlight)
+        {
+            if (math.lengthsq(downlight) < 1e-6f) { downlight = new float2(1f, 0f); stretch = 1f; }
+            float2 c = d - downlight * ((stretch - 1f) * radius);
+            float u = math.dot(c, downlight) / (radius * stretch), v = (c.x * downlight.y - c.y * downlight.x) / radius;
+            float q = u * u + v * v;
+            if (q >= 1f) return 0f;
+            float t = 1f - q;
+            return t * t;
+        }
+
+        /// <summary>Metres from a man's feet to the far rim of his footprint.</summary>
+        public static float Reach(float radius, float stretch, float2 downlight) =>
+            math.lengthsq(downlight) < 1e-6f ? radius : radius * (2f * stretch - 1f);
+
+        /// <summary>
+        /// The footprint baked for each of Phases x Phases sub-texel positions: stamps[(phase * side + dz + k) * side + dx + k]
+        /// is the byte a man adds to the texel dx, dz from his own, phase = pz * Phases + px, side = 2k + 1. spans[phase * side
+        /// + dz + k] holds the first and last dx + k of that row that is not 0 (x greater than y: the row is empty), and
+        /// rows[phase] the first and last dz with anything in it, so the splat never walks an empty row. Returns k.
+        /// </summary>
+        public static int BuildStamps(float radius, float stretch, float2 downlight, float cell, ref NativeArray<byte> stamps, ref NativeArray<int2> spans, ref NativeArray<int2> rows)
+        {
+            int k = (int)math.ceil(Reach(radius, stretch, downlight) / cell) + 1, side = 2 * k + 1;
+            int need = Phases * Phases * side * side;
+            if (!stamps.IsCreated || stamps.Length != need)
+            {
+                if (stamps.IsCreated) stamps.Dispose();
+                if (spans.IsCreated) spans.Dispose();
+                stamps = new NativeArray<byte>(need, Allocator.Persistent);
+                spans = new NativeArray<int2>(Phases * Phases * side, Allocator.Persistent);
+            }
+            if (!rows.IsCreated) rows = new NativeArray<int2>(Phases * Phases, Allocator.Persistent);
+            for (int pz = 0; pz < Phases; pz++)
+            for (int px = 0; px < Phases; px++)
+            {
+                int phase = pz * Phases + px;
+                var used = new int2(k + 1, -k - 1);
+                float ox = (px + 0.5f) / Phases, oz = (pz + 0.5f) / Phases;   // where in his texel the man stands
+                for (int dz = -k; dz <= k; dz++)
+                {
+                    int first = side, last = -1, row = (phase * side + dz + k) * side;
+                    for (int dx = -k; dx <= k; dx++)
+                    {
+                        float wgt = Footprint(new float2((dx - ox) * cell, (dz - oz) * cell), radius, stretch, downlight);
+                        byte b = (byte)math.min(255, (int)(wgt * PerMan * 255f + 0.5f));
+                        stamps[row + dx + k] = b;
+                        if (b != 0) { if (first == side) first = dx + k; last = dx + k; }
+                    }
+                    spans[phase * side + dz + k] = new int2(first, last);
+                    if (last >= 0) { used.x = math.min(used.x, dz); used.y = dz; }
+                }
+                rows[phase] = used;
+            }
+            return k;
+        }
+
+        /// <summary>Clears the map and stamps every drawn man into it. Pure: no Unity object is touched.</summary>
+        [BurstCompile]
+        public struct SplatJob : IJob
+        {
+            [ReadOnly] public NativeArray<VatInstance> Men;
+            public int NearCount, FarCount;
+            [ReadOnly] public NativeArray<byte> Stamps;
+            [ReadOnly] public NativeArray<int2> Spans, Rows;
+            public int K, W, H;
+            public float InvCell;
+            public NativeArray<byte> Texels;
+
+            public void Execute()
+            {
+                for (int i = 0; i < Texels.Length; i++) Texels[i] = 0;
+                for (int i = 0; i < NearCount; i++) Splat(Men[i].Pos);
+                for (int i = Men.Length - FarCount; i < Men.Length; i++) Splat(Men[i].Pos);
+            }
+
+            void Splat(float3 p)
+            {
+                // texel i's centre is at (i - 0.5) x cell, so a man at x stands (x / cell + 0.5) texels in
+                float fx = p.x * InvCell + 0.5f, fz = p.z * InvCell + 0.5f;
+                if (!(fx >= 0f && fz >= 0f && fx < W + K && fz < H + K)) return;   // off the map (or NaN)
+                int bx = (int)fx, bz = (int)fz;
+                int px = math.min(Phases - 1, (int)((fx - bx) * Phases)), pz = math.min(Phases - 1, (int)((fz - bz) * Phases));
+                int side = 2 * K + 1, phase = pz * Phases + px;
+                int lo = 1 - bx + K, hi = W - 2 - bx + K;   // the outer ring stays empty
+                int2 used = Rows[phase];
+                for (int dz = used.x; dz <= used.y; dz++)
+                {
+                    int z = bz + dz;
+                    if (z < 1 || z > H - 2) continue;
+                    int2 span = Spans[phase * side + dz + K];
+                    int x0 = math.max(span.x, lo), x1 = math.min(span.y, hi);
+                    int dst = z * W + bx - K, src = (phase * side + dz + K) * side;
+                    for (int j = x0; j <= x1; j++)
+                    {
+                        int v = Texels[dst + j] + Stamps[src + j];
+                        Texels[dst + j] = (byte)math.min(v, 255);
+                    }
+                }
+            }
+        }
+
+        public void Dispose()
+        {
+            pending.Complete();
+            scheduled = false;
+            Shader.SetGlobalFloat(StrengthId, 0f);
+            Shader.SetGlobalFloat(KitId, 0f);
+            live = false;
+            if (tex != null) { if (Application.isPlaying) Object.Destroy(tex); else Object.DestroyImmediate(tex); tex = null; }
+            if (texels.IsCreated) texels.Dispose();
+            if (stamps.IsCreated) stamps.Dispose();
+            if (spans.IsCreated) spans.Dispose();
+            if (rows.IsCreated) rows.Dispose();
+        }
+    }
+}
