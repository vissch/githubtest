+
+        // C105s: the three parts settable apart (the lift lowered men-vs-mud 49% at night; the outline and jitter raised
+        // helmet separation 30%)
+        [Test]
+        public void SeparationParts_UnsetFollowSeparation_EachSettableApart()
+        {
+            Assert.AreEqual(Vector4.zero, LodTiers.ReadSeparationParts(), "nothing set: every part off");
+            Assert.AreEqual(0f, LodTiers.SeparationGate(LodTiers.ReadSeparationParts()), "nothing set: the renderer sets nothing");
+
+            Knobs.Set("vat.separation", "1");
+            Assert.AreEqual(new Vector4(1f, 1f, 1f, 0f), LodTiers.ReadSeparationParts(), "vat.separation alone is C105 exactly");
+            Assert.AreEqual(1f, LodTiers.SeparationGate(LodTiers.ReadSeparationParts()));
+
+            Knobs.Set("vat.sepLift", "0");
+            Assert.AreEqual(new Vector4(1f, 1f, 0f, 0f), LodTiers.ReadSeparationParts(), "outline and jitter, no lift");
+            Assert.AreEqual(1f, LodTiers.SeparationGate(LodTiers.ReadSeparationParts()));
+
+            Knobs.Set("vat.sepOutline", "0.5"); Knobs.Set("vat.sepJitter", "2"); Knobs.Set("vat.sepJitterDark", "1");
+            Assert.AreEqual(new Vector4(0.5f, 1f, 0f, 1f), LodTiers.ReadSeparationParts(), "each its own, clamped to 0-1");
+
+            Knobs.Clear();
+            Knobs.Set("vat.separation", "0.4");
+            Assert.AreEqual(new Vector4(0.4f, 0.4f, 0.4f, 0f), LodTiers.ReadSeparationParts());
+            Knobs.Clear();
+            Knobs.Set("vat.sepJitter", "0.7");
+            Assert.AreEqual(new Vector4(0f, 0.7f, 0f, 0f), LodTiers.ReadSeparationParts(), "a part on its own, vat.separation unset");
+            Assert.AreEqual(0.7f, LodTiers.SeparationGate(LodTiers.ReadSeparationParts()));
+            Knobs.Clear();
+            Knobs.Set("vat.sepJitterDark", "1");
+            Assert.AreEqual(0f, LodTiers.SeparationGate(LodTiers.ReadSeparationParts()), "jitter dark alone changes nothing");
+        }
+
+        [Test]
+        public void JitterFactor_SymmetricAsC105_DarkOnlyNeverLifts()
+        {
+            for (int k = 0; k <= 20; k++)
+            {
+                float h = k / 20f;
+                Assert.AreEqual(1f, LodTiers.JitterFactor(h, 0f, 0f), "jitter off: untouched");
+                Assert.That(LodTiers.JitterFactor(h, 1f, 0f), Is.EqualTo(1f + 0.16f * 1f * (h * 2f - 1f)).Within(1e-6f), "dark 0: C105's +-16%, written out");
+                float dark = LodTiers.JitterFactor(h, 1f, 1f);
+                Assert.That(dark, Is.EqualTo(1f - 0.32f * h).Within(1e-6f), "dark 1: -32%..0");
+                Assert.That(dark, Is.LessThanOrEqualTo(1f), "dark 1 never lifts a man toward the mud");
+                Assert.That(LodTiers.JitterFactor(h, 1f, 0.5f), Is.LessThanOrEqualTo(Mathf.Max(1f, LodTiers.JitterFactor(h, 1f, 0f)) + 1e-6f));
+            }
+            Assert.That(LodTiers.JitterFactor(0f, 1f, 0f), Is.EqualTo(0.84f).Within(1e-6f));
+            Assert.That(LodTiers.JitterFactor(1f, 1f, 0f), Is.EqualTo(1.16f).Within(1e-6f));
+            Assert.That(LodTiers.JitterFactor(1f, 1f, 1f), Is.EqualTo(0.68f).Within(1e-6f));
+            Assert.That(LodTiers.JitterFactor(1f, 0.5f, 1f), Is.EqualTo(0.84f).Within(1e-6f), "the jitter part scales the range");
+        }
+
+        [Test]
+        public void Shader_EachPartBehindItsOwnTest_AndTheRendererSetsThePartsWithTheGate()
+        {
+            string src = Regex.Replace(File.ReadAllText(ShaderPath), @"//[^\n]*", "");
+            int uses = 0;
+            foreach (Match m in Regex.Matches(src, @"^[^\n]*\b_SepParts\b[^\n]*$", RegexOptions.Multiline))
+            {
+                string line = m.Value.Trim();
+                if (line.StartsWith("[HideInInspector] _SepParts") || line == "float4 _SepParts;") continue;
+                uses++;
+                Assert.That(line, Does.StartWith("if (_Separation > 0.0 && _SepParts."), "a part used outside the gate: " + line);
+            }
+            Assert.AreEqual(3, uses, "outline, jitter (with jitter dark) and lift");
+            Assert.That(src, Does.Contain("grow = pow(grow, 1.0 - 0.6 * _SepParts.x)"));
+            Assert.That(src, Does.Contain("0.16 * _SepParts.y * SepJitter("));
+            Assert.That(src, Does.Contain("0.30 * _SepParts.z * saturate("));
+
+            string cs = File.ReadAllText(RendererPath);
+            Assert.That(cs, Does.Contain("separation = LodTiers.SeparationGate(separationParts)"));
+            Assert.That(cs, Does.Contain("SetVector(SepPartsId, parts)"), "the parts go wherever the gate goes, only when it is on");
+        }
     }
