+// Phase: tooling (AOSA loop, C106) - fx.smokeShear: the barrage smoke drifts and shears down the breeze, plays only its
+// dense frames (no hollow rings), has a value inside it, and thins sooner over men. At 0 every number is the old one.
+using NUnit.Framework;
+using UnityEngine;
+using TW.Presentation;
+using TW.Presentation.Tactical;
+
+namespace TW.Tests
+{
+    public class SmokeShearTests
+    {
+        [SetUp] public void SetUp() => Knobs.Clear();
+        [TearDown] public void TearDown() => Knobs.Clear();
+
+        [Test]
+        public void Knob_DefaultsOff_AndClamps()
+        {
+            Assert.AreEqual("fx.smokeShear", FlipbookFx.ShearKnob);
+            Assert.AreEqual(0f, FlipbookFx.OldShear);
+            Assert.AreEqual(FlipbookFx.OldShear, FlipbookFx.DefaultShear, "off until a blind 2-way passes (rule 6)");
+            Assert.AreEqual(0f, FlipbookFx.ReadShear());
+            Knobs.Set(FlipbookFx.ShearKnob, "1");
+            Assert.AreEqual(1f, FlipbookFx.ReadShear());
+            Knobs.Set(FlipbookFx.ShearKnob, "-2");
+            Assert.AreEqual(0f, FlipbookFx.ReadShear());
+            Knobs.Set(FlipbookFx.ShearKnob, "3");
+            Assert.AreEqual(1f, FlipbookFx.ReadShear());
+        }
+
+        [Test]
+        public void Off_EveryNumberIsTheOldOne()
+        {
+            // the frame, the shape, the fade and the opacity with the knob at 0 (and a card with no Thin) are the old ones exactly
+            for (int b = 0; b < (int)FlipbookFx.Book.Count; b++)
+                foreach (float f in new[] { 0f, 1.37f, 5.4f, 11.2f })
+                    Assert.IsTrue(FlipbookFx.ShearFrame((FlipbookFx.Book)b, f, 0f) == f, (FlipbookFx.Book)b + " frame " + f);
+            foreach (float age in new[] { 0f, 0.5f, 3f, 10f })
+            foreach (bool upright in new[] { false, true })
+            {
+                FlipbookFx.ShearShape(age, 0f, 1f, upright, out float roll, out float wide, out float tall);
+                Assert.IsTrue(roll == 0f && wide == 1f && tall == 1f, "age " + age);
+            }
+            Assert.IsTrue(FlipbookFx.ShearFadeStart(0f) == 0.65f, "the old fade starts at 0.65 of the life");
+            foreach (float a in new[] { 1f, 0.65f, 0.5525f })
+                Assert.IsTrue(FlipbookFx.ShearAlpha(a, 0f) == a, "opacity " + a);
+        }
+
+        [Test]
+        public void Frames_OnlyTheDenseOnes_OnTheDeepBooks()
+        {
+            // the Burst hollows into a ring from frame 7 and plays to 11.2; the Smoke (Puff) into a crescent from 4, to 5.4
+            Assert.AreEqual(6.4f, FlipbookFx.ShearFrame(FlipbookFx.Book.Burst, 16f * 0.7f, 1f), 1e-4f);
+            Assert.AreEqual(3.8f, FlipbookFx.ShearFrame(FlipbookFx.Book.Smoke, 9f * 0.6f, 1f), 1e-4f);
+            Assert.Less(FlipbookFx.ShearFrameCap(FlipbookFx.Book.Burst), 7f);
+            Assert.Less(FlipbookFx.ShearFrameCap(FlipbookFx.Book.Smoke), 4f);
+            // scaled, not held: the timing still runs to the end
+            Assert.Less(FlipbookFx.ShearFrame(FlipbookFx.Book.Smoke, 2f, 1f), FlipbookFx.ShearFrame(FlipbookFx.Book.Smoke, 4f, 1f));
+            // half the knob: half way between
+            float half = FlipbookFx.ShearFrame(FlipbookFx.Book.Burst, 11.2f, 0.5f);
+            Assert.AreEqual((11.2f + 6.4f) * 0.5f, half, 1e-3f);
+            // no other book is touched
+            foreach (var book in new[] { FlipbookFx.Book.Column, FlipbookFx.Book.Splash, FlipbookFx.Book.Wings, FlipbookFx.Book.Puff, FlipbookFx.Book.Gas, FlipbookFx.Book.Flash })
+                Assert.IsTrue(FlipbookFx.ShearFrame(book, 5f, 1f) == 5f, book.ToString());
+        }
+
+        [Test]
+        public void Shape_LeansDownWind_AndStretches_KeepingItsArea()
+        {
+            // at 1 s: 57% in; at 3 s: 92%; never past the full lean and stretch
+            FlipbookFx.ShearShape(1f, 1f, 1f, false, out float roll1, out float wide1, out float tall1);
+            FlipbookFx.ShearShape(3f, 1f, 1f, false, out float roll3, out float wide3, out float tall3);
+            FlipbookFx.ShearShape(100f, 1f, 1f, false, out float rollMax, out float wideMax, out _);
+            Assert.AreEqual(1f - Mathf.Exp(-1f / FlipbookFx.ShearTau), (wide1 - 1f) / FlipbookFx.ShearStretch, 1e-4f);
+            Assert.Greater(wide3, wide1); Assert.Less(tall3, tall1);
+            Assert.AreEqual(1f, wide1 * tall1, 1e-5f, "the area is kept: a streak, not a bigger cloud over the men");
+            Assert.AreEqual(1f + FlipbookFx.ShearStretch, wideMax, 1e-3f);
+            Assert.AreEqual(-FlipbookFx.ShearLean, rollMax, 1e-3f);
+            // a wind to the eye's right turns a flat card's top right (a negative roll), an upright card's the other way
+            // (its right is the eye's left)
+            Assert.Less(roll1, 0f); Assert.Less(roll3, roll1);
+            FlipbookFx.ShearShape(1f, 1f, 1f, true, out float rollUp, out _, out _);
+            Assert.AreEqual(-roll1, rollUp, 1e-6f);
+            FlipbookFx.ShearShape(1f, 1f, -1f, false, out float rollLeft, out _, out _);
+            Assert.AreEqual(-roll1, rollLeft, 1e-6f);
+        }
+
+        [Test]
+        public void Side_FollowsTheWindOnTheScreen_NeverBelowTheFloor()
+        {
+            Vector3 right = Vector3.right;
+            Assert.AreEqual(1f, FlipbookFx.ShearSideOf(new Vector2(3f, 0f), right), 1e-5f);
+            Assert.AreEqual(-1f, FlipbookFx.ShearSideOf(new Vector2(-3f, 0f), right), 1e-5f);
+            // along the view: still sheared, by the floor, to the side it leans
+            Assert.AreEqual(FlipbookFx.ShearSide, FlipbookFx.ShearSideOf(new Vector2(0.01f, 5f), right), 1e-5f);
+            Assert.AreEqual(-FlipbookFx.ShearSide, FlipbookFx.ShearSideOf(new Vector2(-0.01f, 5f), right), 1e-5f);
+            Assert.AreEqual(0f, FlipbookFx.ShearSideOf(Vector2.zero, right));
+            // the night's dry breeze (1.6, 0.7) seen with the eye's right along +x
+            Assert.AreEqual(1.6f / new Vector2(1.6f, 0.7f).magnitude, FlipbookFx.ShearSideOf(new Vector2(1.6f, 0.7f), right), 1e-5f);
+        }
+
+        [Test]
+        public void OverMen_ThinnerAndSooner_Elsewhere_Untouched()
+        {
+            Assert.AreEqual(FlipbookFx.ShearThinFade, FlipbookFx.ShearFadeStart(1f), 1e-6f);
+            Assert.Less(FlipbookFx.ShearFadeStart(1f), 0.65f);
+            Assert.Less(FlipbookFx.ShearFadeStart(1f), FlipbookFx.ShearFadeStart(0.5f));
+            Assert.AreEqual(0.65f * (1f - FlipbookFx.ShearThinAlpha), FlipbookFx.ShearAlpha(0.65f, 1f), 1e-6f);
+            Assert.Less(FlipbookFx.ShearAlpha(1f, 1f), FlipbookFx.ShearAlpha(1f, 0.5f));
+            // never more opaque than the recipe (rule 6: the men never lose to the change)
+            foreach (float t in new[] { 0f, 0.25f, 1f, 2f })
+                Assert.LessOrEqual(FlipbookFx.ShearAlpha(0.8f, t), 0.8f);
+        }
+
+        [Test]
+        public void Drift_IsTheBreezeInMetresASecond()
+        {
+            // _TWWind carries the breeze at 0.034 per m/s (Atmosphere); the drift reads it back in m/s
+            Assert.AreEqual(0.034f, FlipbookFx.WindPerMs);
+            Assert.Greater(FlipbookFx.ShearDrift, 1f, "faster than the breeze's old 3.5 x 0.034 share (about 0.2 m/s)");
+        }
+    }
+}
