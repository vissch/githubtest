+        /// <summary>AOSA C106 (fx.smokeShear): is any man under a shell's smoke? The cloud stands over the impact and faces
+        /// the eye, so it covers the ground from a radius in front of it to SmokeReach radii behind it (away from the eye),
+        /// SmokeHalfWidth radii either side. One scan of the live men per shell, and only with the knob on.</summary>
+        bool SmokeOverMen(Vector3 p, float r)
+        {
+            var cam = Camera.main;
+            if (cam == null || Host == null || Host.Local == null) return false;
+            Vector3 eye = cam.transform.position;
+            float fx = p.x - eye.x, fz = p.z - eye.z, flat = Mathf.Sqrt(fx * fx + fz * fz);
+            if (flat < 0.1f) return false;
+            fx /= flat; fz /= flat;
+            float half = r * SmokeHalfWidth, near = -r, far = r * SmokeReach;
+            var w = Host.Local.World;
+            for (int i = 0; i < w.HighWater; i++)
+            {
+                uint flags = w.Flags[i];
+                if ((flags & (uint)UnitFlags.Alive) == 0 || (flags & (uint)UnitFlags.Vehicle) != 0) continue;
+                var q = w.Position[i];
+                float dx = q.x - p.x, dz = q.z - p.z;
+                float d = dx * fx + dz * fz;
+                if (d < near || d > far) continue;
+                if (Mathf.Abs(dx * fz - dz * fx) > half) continue;
+                return true;
+            }
+            return false;
+        }
