@@ -0,0 +1,75 @@
+// Phase: AOSA C105 - vat.separation: men countable in a packed night trench (runs 9: left-trench readability 4/10, three
+// blind critics: "a solid carpet of helmets"). Measured on b0-1 frames: the ink hull (33,25,20) was 36-41% of the
+// crowd's pixels and each far man a 12 px helmet in it. 0 is the old look bit for bit, and that is what these guard:
+// the knob's default, the outline's growth written out as it was, and every shader use of _Separation behind its test.
+using System.IO;
+using System.Text.RegularExpressions;
+using NUnit.Framework;
+using UnityEngine;
+using TW.Presentation;
+using TW.Presentation.Units;
+
+namespace TW.Tests
+{
+    public class SeparationTests
+    {
+        const string ShaderPath = "Assets/_Project/Shaders/VAT_URP.shader";
+        const string RendererPath = "Assets/_Project/Presentation/Units/VATRenderer.cs";
+
+        [SetUp] public void SetUp() => Knobs.Clear();
+        [TearDown] public void TearDown() => Knobs.Clear();
+
+        [Test]
+        public void SeparationKnob_DefaultsToOff_ReadsAndClamps()
+        {
+            Assert.AreEqual("vat.separation", LodTiers.SeparationKnob);
+            Assert.AreEqual(0f, LodTiers.Separation);
+            Assert.AreEqual(0f, LodTiers.ReadSeparation(), "unset, the knob is off");
+            Knobs.Set("vat.separation", "1");
+            Assert.AreEqual(1f, LodTiers.ReadSeparation());
+            Knobs.Set("vat.separation", "0.5");
+            Assert.AreEqual(0.5f, LodTiers.ReadSeparation());
+            Knobs.Set("vat.separation", "3");
+            Assert.AreEqual(1f, LodTiers.ReadSeparation(), "clamped to 0-1");
+            Knobs.Set("vat.separation", "-1");
+            Assert.AreEqual(0f, LodTiers.ReadSeparation());
+        }
+
+        [Test]
+        public void OutlineGrow_OffIsTheOldClamp_OnThinsTheFarLineOnly()
+        {
+            // the old outline pass: _OutlineWidth * scale * clamp(w / 25, 1, 6), written out
+            foreach (float w in new[] { 3f, 25f, 40f, 78f, 125f, 149f, 300f })
+                Assert.AreEqual(Mathf.Clamp(w / 25f, 1f, 6f), LodTiers.OutlineGrow(w, 0f), "off: exactly the old growth at " + w + " m");
+            // on: nothing changes up to 25 m (the close-up ink), and past it the line is thinner, the more the further
+            Assert.AreEqual(1f, LodTiers.OutlineGrow(10f, 1f));
+            Assert.AreEqual(1f, LodTiers.OutlineGrow(25f, 1f));
+            float std = LodTiers.OutlineGrow(78f, 1f) / LodTiers.OutlineGrow(78f, 0f);
+            float back = LodTiers.OutlineGrow(125f, 1f) / LodTiers.OutlineGrow(125f, 0f);
+            Assert.That(std, Is.EqualTo(0.505f).Within(0.01f), "the standard view's focus, 78 m: about half the old line");
+            Assert.That(back, Is.EqualTo(0.38f).Within(0.01f), "the far trench, 125 m");
+            Assert.That(LodTiers.OutlineGrow(150f, 1f), Is.GreaterThan(2f), "the back rank keeps a line (it once lost it entirely)");
+            Assert.That(LodTiers.OutlineGrow(78f, 0.5f), Is.GreaterThan(LodTiers.OutlineGrow(78f, 1f)).And.LessThan(LodTiers.OutlineGrow(78f, 0f)));
+        }
+
+        [Test]
+        public void Shader_EveryUseOfSeparationIsBehindItsTest_AndTheRendererSetsItOnlyWhenOn()
+        {
+            string src = Regex.Replace(File.ReadAllText(ShaderPath), @"//[^\n]*", "");
+            // declared once in Properties, once in the per-material buffer; every other line that reads it starts with its test
+            int uses = 0;
+            foreach (Match m in Regex.Matches(src, @"^[^\n]*\b_Separation\b[^\n]*$", RegexOptions.Multiline))
+            {
+                string line = m.Value.Trim();
+                if (line.StartsWith("[HideInInspector] _Separation") || line == "float _Separation;") continue;
+                uses++;
+                Assert.That(line, Does.StartWith("if (_Separation > 0.0)"), "a use of _Separation outside its test changes the old look: " + line);
+            }
+            Assert.AreEqual(3, uses, "the outline's growth, the man's own value and the moon lift");
+            Assert.That(src, Does.Contain("float width = _OutlineWidth * a.scale * grow;"));
+
+            string cs = File.ReadAllText(RendererPath);
+            Assert.That(cs, Does.Contain("if (separation > 0f)"), "at 0 the renderer sets nothing");
+        }
+    }
+}
